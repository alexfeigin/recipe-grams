---
import { sitePath as toSitePath } from "../lib/recipePages";

const base = import.meta.env.BASE_URL;
const sitePath = (path) => toSitePath(base, path);
const sourceUrl =
  "https://github.com/alexfeigin/recipe-grams/blob/astro-recipe-blog";

const navItems = [
  { label: "Featured", href: "#featured" },
  { label: "Legacy Index", href: `${sourceUrl}/index.MD` },
];

const categoryLabels = {
  basics: "Basics",
  doughs_starches: "Doughs & Starches",
  mains: "Mains",
  salads_pickles: "Salads & Pickles",
  sweets: "Sweets",
  snacks: "Snacks",
};

const markerLabels = {
  staple: "Staple",
  grill: "Grill",
  vegan: "Vegan",
};

const recipes = [
  {
    title: "Pizza Dough",
    categoryId: "doughs_starches",
    description:
      "A reliable gram-based dough for weeknight pizza or a slow weekend bake.",
    image: "pizza.jpg",
    href: sitePath("en/pizza_dough/"),
    time: "Hands-on dough",
    markerIds: ["staple"],
  },
  {
    title: "Grilled Chicken Thighs",
    categoryId: "mains",
    description:
      "A high-heat chicken recipe built for repeatable seasoning and juicy results.",
    image: "grilledchicken.jpeg",
    href: sitePath("en/grilled_chicken_thighs/"),
    time: "Dinner anchor",
    markerIds: ["grill"],
  },
  {
    title: "Vegan Chocolate Chip Cookies",
    categoryId: "sweets",
    description:
      "A plant-based cookie that keeps the familiar crisp edge and soft middle.",
    image: "Veganchoc.jpeg",
    href: sitePath("en/choclatechip_vegan/"),
    time: "Bakeable today",
    markerIds: ["vegan"],
  },
  {
    title: "Quinoa",
    categoryId: "basics",
    description:
      "A simple base recipe for fluffy quinoa measured by weight, not cups.",
    image: "quinoa.jpg",
    href: sitePath("en/quinoa/"),
    time: "Pantry base",
    markerIds: ["vegan"],
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Recipe-Grams is a bilingual gram-based recipe collection."
    />
    <title>Recipe-Grams</title>
  </head>
  <body>
    <!--
      THESIS: Recipe-Grams opens as a working recipe index, refusing a blog hero or marketing pitch.
      OWN-WORLD: warm kitchen paper, tomato and olive accents, steel rules, compact photo-led recipe cards.
      STORY: readers can recognize the collection, scan sample recipes, use navigation, and open legacy sources.
      FIRST VIEWPORT: brand and controls sit in a dense top bar above a browse board with filters and featured cards.
      FORM: scoped static browse shell for issue #4; seed key: ticket-4-static-english-home.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
    -->
    <header class="site-header">
      <a class="brand" href={sitePath("")} aria-label="Recipe-Grams home">
        <span class="brand-mark" aria-hidden="true">Rg</span>
        <span>
          <strong>Recipe-Grams</strong>
          <small>Measured family recipes</small>
        </span>
      </a>

      <input class="nav-toggle" type="checkbox" id="nav-toggle" />
      <label
        class="menu-button"
        for="nav-toggle"
        aria-label="Toggle navigation"
      >
        <span></span>
        <span></span>
        <span></span>
      </label>

      <nav class="nav-panel" aria-label="Main navigation">
        {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
    </header>

    <main>
      <section class="browse-hero" aria-labelledby="page-title">
        <div class="hero-copy">
          <h1 id="page-title">Recipe-Grams</h1>
          <p>
            A bilingual recipe collection for cooks who want ingredient weights,
            stable links, and a faster way to choose what to make.
          </p>
        </div>

        <div class="browse-tools" aria-label="Browse summary">
          <div>
            <span>38</span>
            English files
          </div>
          <div>
            <span>38</span>
            Hebrew files
          </div>
          <div>
            <span>100%</span>
            Gram-first
          </div>
        </div>
      </section>

      <section
        class="recipe-board"
        id="featured"
        aria-labelledby="featured-title"
      >
        <div class="section-heading">
          <h2 id="featured-title">Featured Sample Recipes</h2>
          <p>
            This first Astro page uses a hardcoded sample while the catalog
            pipeline is built in later tickets.
          </p>
        </div>

        <div class="recipe-grid">
          {
            recipes.map((recipe) => (
              <article class="recipe-card">
                <a href={recipe.href} aria-label={`Open ${recipe.title}`}>
                  <img
                    src={sitePath(recipe.image)}
                    alt={`${recipe.title} recipe photo`}
                    loading="eager"
                  />
                  <div class="card-body">
                    <div class="card-meta">
                      <span>{categoryLabels[recipe.categoryId]}</span>
                      <span>{recipe.time}</span>
                    </div>
                    <h3>{recipe.title}</h3>
                    <p>{recipe.description}</p>
                    <div class="markers">
                      {recipe.markerIds.map((markerId) => (
                        <span>{markerLabels[markerId]}</span>
                      ))}
                    </div>
                  </div>
                </a>
              </article>
            ))
          }
        </div>
      </section>
    </main>
  </body>
</html>

<style>
  :root {
    color-scheme: light;
    --paper: #f8f4ec;
    --surface: #fffdf8;
    --ink: #25211c;
    --muted: #70685e;
    --tomato: #b43e2f;
    --olive: #687449;
    --steel: #d8d0c3;
    --shadow: 0 18px 48px rgba(61, 43, 28, 0.16);
    font-family:
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    min-width: 320px;
    background:
      radial-gradient(
        circle at top left,
        rgba(180, 62, 47, 0.13),
        transparent 32rem
      ),
      linear-gradient(180deg, #fbf7ef 0%, var(--paper) 44%, #efe7d9 100%);
    color: var(--ink);
  }

  a {
    color: inherit;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    width: min(1180px, calc(100% - 2rem));
    min-height: 78px;
    margin: 0 auto;
    padding: 0.8rem 0;
    background: rgba(248, 244, 236, 0.92);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(112, 104, 94, 0.22);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    width: 46px;
    height: 46px;
    place-items: center;
    border-radius: 10px;
    background: var(--tomato);
    color: #fffdf8;
    font-weight: 850;
    letter-spacing: 0;
  }

  .brand strong,
  .brand small {
    display: block;
  }

  .brand strong {
    font-size: 1.08rem;
  }

  .brand small {
    color: var(--muted);
    font-size: 0.82rem;
  }

  .nav-toggle {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .menu-button {
    display: none;
  }

  .nav-panel {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .nav-panel a,
  .nav-panel button {
    min-height: 42px;
    border: 0;
    border-radius: 10px;
    padding: 0.65rem 0.9rem;
    color: var(--ink);
    font: inherit;
    font-weight: 720;
    text-decoration: none;
  }

  .nav-panel a:hover,
  .nav-panel a:focus-visible {
    background: rgba(104, 116, 73, 0.15);
    outline: none;
  }

  main {
    width: min(1180px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 2.2rem 0 4rem;
  }

  .browse-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(280px, 0.8fr);
    gap: 2rem;
    align-items: end;
    padding: 2.4rem 0 1.6rem;
  }

  .hero-copy h1 {
    max-width: 8ch;
    margin: 0;
    font-size: clamp(3rem, 9vw, 6rem);
    line-height: 0.9;
    letter-spacing: 0;
  }

  .hero-copy p {
    max-width: 58ch;
    margin: 1.25rem 0 0;
    color: #4f463c;
    font-size: clamp(1.05rem, 2vw, 1.24rem);
    line-height: 1.55;
  }

  .browse-tools {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    overflow: hidden;
    border: 1px solid rgba(112, 104, 94, 0.24);
    border-radius: 14px;
    background: rgba(255, 253, 248, 0.78);
    box-shadow: var(--shadow);
  }

  .browse-tools div {
    min-width: 0;
    padding: 1rem;
    color: var(--muted);
    font-size: 0.82rem;
    line-height: 1.2;
  }

  .browse-tools div + div {
    border-left: 1px solid rgba(112, 104, 94, 0.2);
  }

  .browse-tools span {
    display: block;
    margin-bottom: 0.25rem;
    color: var(--ink);
    font-size: 1.55rem;
    font-weight: 850;
  }

  .recipe-board {
    padding-top: 1.2rem;
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 1rem;
  }

  .section-heading h2 {
    margin: 0;
    font-size: clamp(1.65rem, 4vw, 2.6rem);
    line-height: 1;
  }

  .section-heading p {
    max-width: 42ch;
    margin: 0;
    color: var(--muted);
    line-height: 1.45;
  }

  .recipe-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 1rem;
  }

  .recipe-card {
    min-width: 0;
    overflow: hidden;
    border-radius: 14px;
    background: var(--surface);
    box-shadow: 0 14px 32px rgba(61, 43, 28, 0.13);
  }

  .recipe-card a {
    display: grid;
    grid-template-rows: 176px 1fr;
    min-height: 100%;
    text-decoration: none;
  }

  .recipe-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: #d8d0c3;
  }

  .card-body {
    display: grid;
    gap: 0.75rem;
    padding: 1rem;
  }

  .card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    color: var(--olive);
    font-size: 0.78rem;
    font-weight: 820;
  }

  .card-meta span + span::before {
    content: "/";
    margin-right: 0.45rem;
    color: var(--steel);
  }

  .recipe-card h3 {
    margin: 0;
    font-size: 1.18rem;
    line-height: 1.15;
  }

  .recipe-card p {
    margin: 0;
    color: #5b534b;
    font-size: 0.94rem;
    line-height: 1.45;
  }

  .markers {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    align-self: end;
  }

  .markers span {
    border-radius: 999px;
    padding: 0.35rem 0.55rem;
    background: rgba(180, 62, 47, 0.12);
    color: #7f2f24;
    font-size: 0.75rem;
    font-weight: 800;
  }

  @media (max-width: 640px) {
    .site-header {
      width: min(100% - 1rem, 1180px);
      min-height: 68px;
    }

    .brand-mark {
      width: 42px;
      height: 42px;
    }

    .brand small {
      display: none;
    }

    .menu-button {
      display: grid;
      width: 44px;
      height: 44px;
      place-content: center;
      gap: 5px;
      border-radius: 10px;
      background: var(--surface);
      box-shadow: 0 8px 24px rgba(61, 43, 28, 0.12);
      cursor: pointer;
    }

    .menu-button span {
      display: block;
      width: 20px;
      height: 2px;
      background: var(--ink);
    }

    .nav-panel {
      position: absolute;
      top: calc(100% + 0.55rem);
      right: 0;
      left: 0;
      display: none;
      align-items: stretch;
      border-radius: 14px;
      padding: 0.55rem;
      background: var(--surface);
      box-shadow: var(--shadow);
    }

    .nav-panel a,
    .nav-panel button {
      justify-content: flex-start;
      width: 100%;
    }

    .nav-toggle:checked ~ .nav-panel {
      display: grid;
      gap: 0.2rem;
    }

    main {
      width: min(100% - 1rem, 1180px);
      padding-top: 1.2rem;
    }

    .browse-hero {
      grid-template-columns: 1fr;
      gap: 1.2rem;
      padding-top: 1rem;
    }

    .hero-copy h1 {
      max-width: 7ch;
    }

    .section-heading {
      display: block;
    }

    .section-heading p {
      margin-top: 0.7rem;
    }

    .recipe-grid {
      grid-template-columns: 1fr;
    }

    .recipe-card a {
      grid-template-rows: 188px 1fr;
    }
  }
</style>
