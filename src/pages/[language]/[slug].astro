---
// One localized recipe page: the recipe's Markdown body rendered into the
// shared site document. The page decides what only it knows — the recipe's
// title and description, its social card, its search metadata, and where the
// language switch leads when the other language has this recipe — and leaves
// the document shell, header, and language-derived setup to SitePage.
import SitePage from "../../layouts/SitePage.astro";
import type { SocialImage } from "../../layouts/SitePage.astro";
import {
  getRecipeMetadata,
  getRecipeSearchMetadata,
} from "../../lib/recipeCatalog";
import {
  findLocalizedRecipe,
  listLocalizedRecipes,
  renderRecipeBody,
} from "../../lib/recipePages";
import { getPageContext } from "../../lib/pageContext";
import { sitePath } from "../../lib/site";

export function getStaticPaths() {
  return listLocalizedRecipes().map((recipe) => ({
    params: {
      language: recipe.language,
      slug: recipe.slug,
    },
  }));
}

const recipe = findLocalizedRecipe(Astro.params.language, Astro.params.slug);

if (!recipe) {
  return Astro.redirect("/");
}

const page = getPageContext(recipe.language, import.meta.env.BASE_URL);
const basePath = page.basePath;
const metadata = getRecipeMetadata(recipe);
const searchMetadata = getRecipeSearchMetadata(recipe);
const recipeHtml = await renderRecipeBody(recipe, basePath);
const recipeHref = sitePath(basePath, `${recipe.language}/${recipe.slug}/`);
const title = `${metadata.title} | Recipe-Grams`;

// Without a recipe photo the shared placeholder card stands in, and only then
// are its dimensions known well enough to publish.
const fallbackSocialImageSource = "recipe-grams-card-placeholder.png";
const socialImageSource =
  metadata.socialImage ?? metadata.image ?? fallbackSocialImageSource;
const usesFallbackSocialImage = socialImageSource === fallbackSocialImageSource;
const socialImage: SocialImage = {
  source: socialImageSource,
  alt: metadata.title,
  width: usesFallbackSocialImage ? 562 : undefined,
  height: usesFallbackSocialImage ? 480 : undefined,
  type: usesFallbackSocialImage ? "image/png" : undefined,
};

// The language switch stays on this recipe when the other language has it, and
// falls back to that language's landing page when it does not.
const alternateRecipe = findLocalizedRecipe(
  page.alternateLanguage,
  recipe.slug,
);
const languageHref = alternateRecipe
  ? sitePath(basePath, `${page.alternateLanguage}/${recipe.slug}/`)
  : page.alternateHomeHref;
---

<SitePage
  language={recipe.language}
  title={title}
  description={metadata.description}
  pageHref={recipeHref}
  canonical={true}
  socialImage={socialImage}
  socialType="article"
  brandLine={metadata.title}
  languageHref={languageHref}
  navItems={[{ label: page.labels.home, href: page.homeHref }]}
>
  <Fragment slot="head">
    <meta data-pagefind-filter={`language:${recipe.language}`} />
    {
      searchMetadata.category && (
        <meta
          name="category"
          content={searchMetadata.category}
          data-pagefind-meta="category[content]"
        />
      )
    }
    {
      searchMetadata.markers && (
        <meta
          name="markers"
          content={searchMetadata.markers}
          data-pagefind-meta="markers[content]"
        />
      )
    }
  </Fragment>

  <main>
    <article class="recipe-shell" data-pagefind-body>
      <div class="recipe-body" set:html={recipeHtml} />
    </article>
  </main>
</SitePage>

<style>
  :root {
    --shadow: 0 18px 48px rgba(61, 43, 28, 0.14);
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    min-width: 320px;
    background: linear-gradient(
      180deg,
      #fbf7ef 0%,
      var(--paper) 48%,
      #efe7d9 100%
    );
    color: var(--ink);
  }

  main {
    width: min(980px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 2.2rem 0 4rem;
  }

  .recipe-shell {
    overflow: hidden;
    border: 1px solid rgba(112, 104, 94, 0.22);
    border-radius: 8px;
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .recipe-body {
    width: min(100%, 760px);
    margin: 0 auto;
    padding: clamp(1.25rem, 4vw, 3rem);
    line-height: 1.65;
  }

  .recipe-body :global(h1) {
    margin: 0 0 1rem;
    font-size: clamp(2rem, 6vw, 4rem);
    line-height: 1;
    letter-spacing: 0;
  }

  .recipe-body :global(h2) {
    margin: 2rem 0 0.75rem;
    font-size: clamp(1.35rem, 3vw, 2rem);
    line-height: 1.15;
    letter-spacing: 0;
  }

  .recipe-body :global(h3) {
    margin: 1.5rem 0 0.5rem;
    font-size: 1.12rem;
    letter-spacing: 0;
  }

  .recipe-body :global(p),
  .recipe-body :global(ul),
  .recipe-body :global(ol) {
    margin: 0.8rem 0;
  }

  .recipe-body :global(li + li) {
    margin-top: 0.35rem;
  }

  .recipe-body :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
  }

  .recipe-body :global(table) {
    display: block;
    width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
  }

  .recipe-body :global(td),
  .recipe-body :global(th) {
    padding: 0.35rem;
    vertical-align: top;
  }

  @media (max-width: 640px) {
    main {
      width: min(100% - 1rem, 980px);
    }
  }
</style>
