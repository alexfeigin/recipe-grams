---
import FaviconLinks from "../../components/FaviconLinks.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SocialMeta from "../../components/SocialMeta.astro";
import "../../styles/design-tokens.css";
import {
  findLocalizedRecipe,
  getRecipeMetadata,
  getRecipeSearchMetadata,
  labelsByLanguage,
  listLocalizedRecipes,
  renderRecipeBody,
  sitePath,
} from "../../lib/recipePages";

export function getStaticPaths() {
  return listLocalizedRecipes().map((recipe) => ({
    params: {
      language: recipe.language,
      slug: recipe.slug,
    },
  }));
}

const recipe = findLocalizedRecipe(Astro.params.language, Astro.params.slug);

if (!recipe) {
  return Astro.redirect("/");
}

const basePath = import.meta.env.BASE_URL;
const metadata = getRecipeMetadata(recipe);
const searchMetadata = getRecipeSearchMetadata(recipe);
const recipeHtml = await renderRecipeBody(recipe, basePath);
const canonicalPath = sitePath(basePath, `${recipe.language}/${recipe.slug}/`);
const canonicalUrl = new URL(canonicalPath, Astro.site ?? Astro.url).href;
const fallbackSocialImageSource = "recipe-grams-card-placeholder.png";
const socialImageSource =
  metadata.socialImage ?? metadata.image ?? fallbackSocialImageSource;
const socialImage = new URL(
  sitePath(basePath, socialImageSource),
  Astro.site ?? Astro.url,
).href;
const usesFallbackSocialImage = socialImageSource === fallbackSocialImageSource;
const direction = recipe.language === "he" ? "rtl" : "ltr";
const locale = recipe.language === "he" ? "he_IL" : "en_US";
const alternateLanguage = recipe.language === "he" ? "en" : "he";
const alternateRecipe = findLocalizedRecipe(alternateLanguage, recipe.slug);
const labels = labelsByLanguage[recipe.language];
const homeLabel = recipe.language === "he" ? "עמוד הבית" : "Home";
const homeHref =
  recipe.language === "he" ? sitePath(basePath, "he/") : sitePath(basePath, "");
const languageHref = alternateRecipe
  ? sitePath(basePath, `${alternateLanguage}/${recipe.slug}/`)
  : alternateLanguage === "he"
    ? sitePath(basePath, "he/")
    : sitePath(basePath, "");
const navItems = [{ label: homeLabel, href: homeHref }];
---

<html lang={recipe.language} dir={direction}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={metadata.description} />
    <SocialMeta
      title={`${metadata.title} | Recipe-Grams`}
      description={metadata.description}
      url={canonicalUrl}
      image={socialImage}
      imageAlt={metadata.title}
      locale={locale}
      type="article"
      imageWidth={usesFallbackSocialImage ? 562 : undefined}
      imageHeight={usesFallbackSocialImage ? 480 : undefined}
      imageType={usesFallbackSocialImage ? "image/png" : undefined}
    />
    <meta data-pagefind-filter={`language:${recipe.language}`} />
    {
      searchMetadata.category && (
        <meta
          name="category"
          content={searchMetadata.category}
          data-pagefind-meta="category[content]"
        />
      )
    }
    {
      searchMetadata.markers && (
        <meta
          name="markers"
          content={searchMetadata.markers}
          data-pagefind-meta="markers[content]"
        />
      )
    }
    <link rel="canonical" href={canonicalUrl} />
    <FaviconLinks />
    <title>{metadata.title} | Recipe-Grams</title>
  </head>
  <body>
    <SiteHeader
      language={recipe.language}
      brandLine={metadata.title}
      homeHref={homeHref}
      languageHref={languageHref}
      homeLabel={labels.accessibility.home}
      toggleNavigationLabel={labels.accessibility.toggleNavigation}
      navItems={navItems}
    />

    <main>
      <article class="recipe-shell" data-pagefind-body>
        <div class="recipe-body" set:html={recipeHtml} />
      </article>
    </main>
  </body>
</html>

<style>
  :root {
    color-scheme: light;
    --paper: #f8f4ec;
    --surface: #fffdf8;
    --ink: #25211c;
    --muted: #70685e;
    --tomato: #b43e2f;
    --olive: #687449;
    --steel: #d8d0c3;
    --shadow: 0 18px 48px rgba(61, 43, 28, 0.14);
    font-family:
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    min-width: 320px;
    background: linear-gradient(
      180deg,
      #fbf7ef 0%,
      var(--paper) 48%,
      #efe7d9 100%
    );
    color: var(--ink);
  }

  a {
    color: var(--tomato);
  }

  main {
    width: min(980px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 2.2rem 0 4rem;
  }

  .recipe-shell {
    overflow: hidden;
    border: 1px solid rgba(112, 104, 94, 0.22);
    border-radius: 8px;
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .recipe-body {
    width: min(100%, 760px);
    margin: 0 auto;
    padding: clamp(1.25rem, 4vw, 3rem);
    line-height: 1.65;
  }

  .recipe-body :global(h1) {
    margin: 0 0 1rem;
    font-size: clamp(2rem, 6vw, 4rem);
    line-height: 1;
    letter-spacing: 0;
  }

  .recipe-body :global(h2) {
    margin: 2rem 0 0.75rem;
    font-size: clamp(1.35rem, 3vw, 2rem);
    line-height: 1.15;
    letter-spacing: 0;
  }

  .recipe-body :global(h3) {
    margin: 1.5rem 0 0.5rem;
    font-size: 1.12rem;
    letter-spacing: 0;
  }

  .recipe-body :global(p),
  .recipe-body :global(ul),
  .recipe-body :global(ol) {
    margin: 0.8rem 0;
  }

  .recipe-body :global(li + li) {
    margin-top: 0.35rem;
  }

  .recipe-body :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
  }

  .recipe-body :global(table) {
    display: block;
    width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
  }

  .recipe-body :global(td),
  .recipe-body :global(th) {
    padding: 0.35rem;
    vertical-align: top;
  }

  @media (max-width: 640px) {
    main {
      width: min(100% - 1rem, 980px);
    }
  }
</style>
