---
import { labelsByLanguage, sitePath } from "../lib/recipePages";
import type { RecipeLanguage } from "../lib/recipePages";

type NavItem = {
  label: string;
  href: string;
};

type Props = {
  language: RecipeLanguage;
  brandLine: string;
  homeHref: string;
  languageHref: string;
  homeLabel: string;
  toggleNavigationLabel: string;
  navItems: NavItem[];
};

const {
  language,
  brandLine,
  homeHref,
  languageHref,
  homeLabel,
  toggleNavigationLabel,
  navItems,
} = Astro.props;

const navLabel = language === "he" ? "ניווט ראשי" : "Main navigation";
const languagePickerLabel = language === "he" ? "בחירת שפה" : "Language";
const hebrewLabel = "עב";
const englishLabel = "EN";
const logoHref = sitePath(import.meta.env.BASE_URL, "recipe-grams-logo.png");
const searchLabels = labelsByLanguage[language].search;
const pagefindBundle = sitePath(
  import.meta.env.BASE_URL,
  "pagefind/pagefind.js",
);
const searchDirection = language === "he" ? "rtl" : "ltr";
---

<header class="site-header">
  <a class="brand" href={homeHref} aria-label={homeLabel}>
    <img
      class="brand-mark"
      src={logoHref}
      alt=""
      width="46"
      height="46"
      decoding="async"
      aria-hidden="true"
    />
    <span>
      <strong>Recipe-Grams</strong>
      <small>{brandLine}</small>
    </span>
  </a>

  <nav
    id="main-navigation"
    class="nav-panel"
    aria-label={navLabel}
    dir={searchDirection}
  >
    {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>

  <div class="search-area" data-search-area dir={searchDirection}>
    <label class="search-control">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="10.5" cy="10.5" r="6.5"></circle>
        <path d="m16 16 4 4"></path>
      </svg>
      <input
        class="search-input"
        type="search"
        autocomplete="off"
        spellcheck="false"
        aria-label={searchLabels.title}
        aria-controls="search-results-panel"
        aria-describedby="search-status"
        aria-expanded="false"
        placeholder={searchLabels.placeholder}
        data-search-input
      />
    </label>
    <button
      class="search-close"
      type="button"
      aria-label={searchLabels.close}
      data-search-close
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="m6 6 12 12M18 6 6 18"></path>
      </svg>
    </button>

    <p
      id="search-status"
      class="visually-hidden"
      data-search-status
      role="status"
      aria-live="polite"
      aria-atomic="true"
    >
    </p>

    <section
      id="search-results-panel"
      class="search-dropdown"
      data-search-overlay
      aria-label={searchLabels.resultsLabel}
      hidden
    >
      <p class="search-summary" data-search-summary></p>
      <button class="search-retry" type="button" data-search-retry hidden>
        {searchLabels.retry}
      </button>
      <div
        class="search-results"
        data-search-results
        aria-label={searchLabels.resultsLabel}
      >
      </div>
    </section>
  </div>

  <div
    class="language-picker desktop-language-picker"
    aria-label={languagePickerLabel}
  >
    {
      language === "he" ? (
        <span aria-current="page">{hebrewLabel}</span>
      ) : (
        <a href={languageHref}>{hebrewLabel}</a>
      )
    }
    {
      language === "en" ? (
        <span aria-current="page">{englishLabel}</span>
      ) : (
        <a href={languageHref}>{englishLabel}</a>
      )
    }
  </div>

  <div class="mobile-actions">
    <div class="language-picker" aria-label={languagePickerLabel}>
      {
        language === "he" ? (
          <span aria-current="page">{hebrewLabel}</span>
        ) : (
          <a href={languageHref}>{hebrewLabel}</a>
        )
      }
      {
        language === "en" ? (
          <span aria-current="page">{englishLabel}</span>
        ) : (
          <a href={languageHref}>{englishLabel}</a>
        )
      }
    </div>

    <button
      class="menu-button"
      type="button"
      aria-label={toggleNavigationLabel}
      aria-expanded="false"
      aria-controls="main-navigation"
    >
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </button>
  </div>

  <script is:inline>
    const menuButton = document.querySelector(".menu-button");
    const navigation = document.getElementById("main-navigation");
    const mobileNavigation = window.matchMedia("(max-width: 880px)");
    let lastFocusedElement = document.activeElement;

    function setNavigationOpen(open, restoreFocus = false) {
      const expanded = open && mobileNavigation.matches;
      menuButton.setAttribute("aria-expanded", String(expanded));
      navigation.classList.toggle("is-open", expanded);
      if (restoreFocus) menuButton.focus({ preventScroll: true });
    }

    setNavigationOpen(window.location.hash === "#nav-open");

    menuButton.addEventListener("click", (event) => {
      const open = menuButton.getAttribute("aria-expanded") !== "true";
      setNavigationOpen(open);
      // The drawer precedes the trigger in DOM order. Keyboard activation
      // starts at its first link so subsequent Tab presses follow the links.
      if (open && event.detail === 0) navigation.querySelector("a")?.focus();
    });

    navigation.addEventListener("click", (event) => {
      if (event.target instanceof Element && event.target.closest("a")) {
        setNavigationOpen(false, mobileNavigation.matches);
      }
    });

    document.addEventListener("keydown", (event) => {
      if (
        event.key === "Escape" &&
        menuButton.getAttribute("aria-expanded") === "true"
      ) {
        event.preventDefault();
        setNavigationOpen(false, true);
      }
    });

    document.addEventListener("focusin", (event) => {
      lastFocusedElement = event.target;
      if (
        !navigation.contains(event.target) &&
        !menuButton.contains(event.target)
      ) {
        setNavigationOpen(false);
      }
    });

    mobileNavigation.addEventListener("change", () => {
      // CSS can hide and blur the focused control before the media event fires.
      const focusedElement =
        document.activeElement === document.body
          ? lastFocusedElement
          : document.activeElement;
      const focusInNavigation = navigation.contains(focusedElement);
      const focusOnTrigger = focusedElement === menuButton;
      setNavigationOpen(false, mobileNavigation.matches && focusInNavigation);
      if (!mobileNavigation.matches && focusOnTrigger)
        navigation.querySelector("a")?.focus();
    });
  </script>
</header>

<button
  class="back-to-top"
  type="button"
  aria-label={labelsByLanguage[language].accessibility.backToTop}
  data-back-to-top
  hidden
>
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <path d="m5 15 7-7 7 7"></path>
  </svg>
</button>

<script
  is:inline
  define:vars={{
    language,
    pagefindBundle,
    searchLabels,
    basePath: import.meta.env.BASE_URL,
  }}
>
  const header = document.querySelector(".site-header");
  const searchArea = document.querySelector("[data-search-area]");
  const overlay = document.querySelector("[data-search-overlay]");
  const input = document.querySelector("[data-search-input]");
  const status = document.querySelector("[data-search-status]");
  const summary = document.querySelector("[data-search-summary]");
  const results = document.querySelector("[data-search-results]");
  const closeButton = document.querySelector("[data-search-close]");
  const backToTop = document.querySelector("[data-back-to-top]");
  const retryButton = document.querySelector("[data-search-retry]");
  let pagefindPromise;
  let loadAttempt = 0;
  let lastSearchId = 0;

  function normalizeResultUrl(url) {
    const normalizedBase = basePath.endsWith("/") ? basePath : `${basePath}/`;
    if (url.startsWith(normalizedBase)) {
      return url;
    }
    return `${normalizedBase}${url.replace(/^\/+/, "")}`;
  }

  async function getPagefind() {
    // Browsers can cache failed module imports, so retries need a fresh URL.
    const bundleUrl = loadAttempt
      ? `${pagefindBundle}?retry=${loadAttempt}`
      : pagefindBundle;
    pagefindPromise ??= import(bundleUrl)
      .then(async (pagefind) => {
        await pagefind.init?.();
        return pagefind;
      })
      .catch((error) => {
        pagefindPromise = undefined;
        ++loadAttempt;
        throw error;
      });
    return pagefindPromise;
  }

  function hideResultsLayer() {
    overlay.hidden = true;
    input.setAttribute("aria-expanded", "false");
  }

  function showResultsLayer(message) {
    summary.textContent = message;
    status.textContent = message;
    overlay.hidden = false;
    input.setAttribute("aria-expanded", "true");
  }

  function activateSearch() {
    header.classList.add("search-active");
    setNavigationOpen(false);
  }

  function closeSearch(restoreFocus = false) {
    ++lastSearchId;
    input.removeAttribute("aria-busy");
    hideResultsLayer();
    if (restoreFocus) {
      input.focus();
    }
    header.classList.remove("search-active");
  }

  function clearResults() {
    results.replaceChildren();
  }

  function renderResults(searchResults) {
    results.replaceChildren();

    for (const result of searchResults) {
      const link = document.createElement("a");
      link.className = "search-result";
      link.href = normalizeResultUrl(result.url);

      const title = document.createElement("strong");
      title.textContent = result.meta.title ?? link.href;
      link.append(title);

      const details = [result.meta.category, result.meta.markers]
        .filter(Boolean)
        .join(" | ");
      if (details) {
        const meta = document.createElement("span");
        meta.className = "search-result-meta";
        meta.textContent = details;
        link.append(meta);
      }

      const excerpt = document.createElement("span");
      excerpt.className = "search-result-excerpt";
      excerpt.innerHTML = result.excerpt;
      link.append(excerpt);

      results.append(link);
    }
  }

  async function runSearch() {
    activateSearch();
    const query = input.value.trim();
    const searchId = ++lastSearchId;

    retryButton.hidden = true;
    if (query.length < 2) {
      input.removeAttribute("aria-busy");
      status.textContent = "";
      clearResults();
      hideResultsLayer();
      return;
    }

    input.setAttribute("aria-busy", "true");
    status.textContent = searchLabels.loading;
    clearResults();
    hideResultsLayer();
    try {
      const pagefind = await getPagefind();
      const search = await pagefind.search(query, { filters: { language } });
      const searchResults = await Promise.all(
        search.results.slice(0, 8).map((result) => result.data()),
      );
      if (searchId !== lastSearchId) return;
      input.removeAttribute("aria-busy");
      if (searchResults.length === 0) {
        showResultsLayer(searchLabels.empty);
        return;
      }
      const foundMessage = searchLabels.found.replace(
        "{count}",
        searchResults.length,
      );
      renderResults(searchResults);
      showResultsLayer(foundMessage);
    } catch {
      if (searchId !== lastSearchId) return;
      input.removeAttribute("aria-busy");
      showResultsLayer(searchLabels.error);
      retryButton.hidden = false;
    }
  }

  closeButton.addEventListener("click", () => closeSearch(true));
  retryButton.addEventListener("click", () => {
    input.focus();
    runSearch();
  });
  input.addEventListener("pointerdown", activateSearch);
  input.addEventListener("focus", activateSearch);
  input.addEventListener("input", () => {
    runSearch();
  });
  input.addEventListener("keydown", (event) => {
    if (event.key === "Enter") runSearch();
    if (event.key === "ArrowDown" && !overlay.hidden) {
      event.preventDefault();
      results.querySelector("a")?.focus();
    }
  });
  document.addEventListener("pointerdown", (event) => {
    if (
      header.classList.contains("search-active") &&
      event.target instanceof Node &&
      !searchArea.contains(event.target)
    ) {
      closeSearch();
    }
  });
  document.addEventListener("focusin", (event) => {
    if (
      header.classList.contains("search-active") &&
      event.target instanceof Node &&
      !searchArea.contains(event.target)
    ) {
      closeSearch();
    }
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && header.classList.contains("search-active")) {
      event.preventDefault();
      closeSearch(true);
    }
  });

  const backToTopFadeStart = 140;
  const backToTopFadeEnd = 720;
  const backToTopMinimumOpacity = 0.14;
  let backToTopFrame = 0;

  function updateBackToTopVisibility() {
    const scrollPosition = window.scrollY;

    if (scrollPosition <= backToTopFadeStart) {
      backToTop.hidden = true;
      return;
    }

    const scrollProgress = Math.min(
      1,
      (scrollPosition - backToTopFadeStart) /
        (backToTopFadeEnd - backToTopFadeStart),
    );
    const opacity =
      backToTopMinimumOpacity + (1 - backToTopMinimumOpacity) * scrollProgress;

    backToTop.style.setProperty("--back-to-top-opacity", opacity.toFixed(3));
    backToTop.hidden = false;
  }

  function scheduleBackToTopUpdate() {
    if (backToTopFrame) {
      return;
    }

    backToTopFrame = window.requestAnimationFrame(() => {
      backToTopFrame = 0;
      updateBackToTopVisibility();
    });
  }

  backToTop.addEventListener("click", () => {
    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    window.scrollTo({
      top: 0,
      behavior: prefersReducedMotion ? "auto" : "smooth",
    });

    const brandLink = document.querySelector(".brand");
    if (brandLink instanceof HTMLElement) {
      brandLink.focus({ preventScroll: true });
    }
  });

  window.addEventListener("scroll", scheduleBackToTopUpdate, {
    passive: true,
  });
  updateBackToTopVisibility();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    box-sizing: border-box;
    display: grid;
    direction: ltr;
    grid-template-columns:
      auto minmax(0, 1fr) minmax(6.75rem, 10rem)
      auto;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    min-height: 78px;
    margin: 0;
    padding: 0.8rem max(1rem, calc((100% - 1180px) / 2));
    background: rgba(248, 244, 236, 0.92);
    border-bottom: 1px solid rgba(112, 104, 94, 0.22);
    backdrop-filter: blur(16px);
    transition: grid-template-columns 240ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .brand {
    display: inline-flex;
    grid-column: 1;
    flex: 0 1 auto;
    min-width: 0;
    align-items: center;
    gap: 0.8rem;
    color: inherit;
    text-decoration: none;
  }

  .brand-mark {
    flex: 0 0 auto;
    width: 46px;
    height: 46px;
    border-radius: 10px;
    object-fit: cover;
  }

  .brand strong,
  .brand small {
    display: block;
  }

  .brand strong {
    font-size: 1.08rem;
  }

  .brand small {
    max-width: 34vw;
    overflow: hidden;
    color: var(--muted);
    font-size: 0.82rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .menu-button {
    display: none;
    border: 0;
    padding: 0;
  }

  .menu-button:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }

  .nav-panel {
    display: flex;
    grid-column: 2;
    flex: 1 1 auto;
    min-width: 0;
    align-items: center;
    justify-content: flex-end;
    gap: 0.35rem;
    margin-left: auto;
    overflow: hidden;
    opacity: 1;
    visibility: visible;
    clip-path: inset(0);
    transition:
      opacity 120ms ease,
      visibility 0s linear,
      clip-path 180ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav-panel a,
  .language-picker a,
  .language-picker span {
    display: inline-flex;
    box-sizing: border-box;
    align-items: center;
  }

  .nav-panel > a {
    flex: 0 0 auto;
    min-height: 42px;
    border-radius: 10px;
    padding: 0.65rem 0.9rem;
    color: var(--ink);
    font-weight: 720;
    text-decoration: none;
    white-space: nowrap;
  }

  .nav-panel > a:hover,
  .nav-panel > a:focus-visible {
    background: rgba(104, 116, 73, 0.15);
    outline: none;
  }

  .search-area {
    position: relative;
    display: inline-flex;
    grid-column: 3;
    flex: 0 1 clamp(6.75rem, 10vw, 10rem);
    min-width: 6.75rem;
    align-items: center;
    gap: 0.55rem;
  }

  .search-control {
    display: inline-flex;
    flex: 1 1 auto;
    min-width: 0;
    align-items: center;
    gap: 0.45rem;
    min-height: 34px;
    border: 1px solid rgba(112, 104, 94, 0.2);
    border-radius: 8px;
    padding: 0.18rem 0.55rem;
    background: rgba(255, 253, 248, 0.55);
    transition:
      min-height 220ms cubic-bezier(0.16, 1, 0.3, 1),
      padding-inline-end 220ms cubic-bezier(0.16, 1, 0.3, 1),
      background-color 180ms ease;
  }

  .search-control svg {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-width: 1.8;
  }

  .search-input {
    width: 100%;
    min-width: 0;
    border: 0;
    padding: 0.3rem 0;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 1rem;
    line-height: 1.2;
  }

  .search-input:focus {
    outline: none;
  }

  .search-input::-webkit-search-cancel-button {
    display: none;
    appearance: none;
  }

  .search-control:focus-within {
    border-color: rgba(180, 62, 47, 0.52);
    box-shadow: 0 0 0 3px rgba(180, 62, 47, 0.12);
  }

  .search-close,
  .search-retry {
    min-height: 42px;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 8px;
    padding: 0.5rem 0.7rem;
    background: rgba(104, 116, 73, 0.12);
    color: var(--ink);
    font: inherit;
    font-size: 0.9rem;
    font-weight: 760;
    white-space: nowrap;
    cursor: pointer;
  }

  .search-close {
    position: absolute;
    inset-inline-end: 2px;
    top: 50%;
    z-index: 1;
    display: inline-flex;
    width: 42px;
    max-width: 42px;
    overflow: hidden;
    padding-inline: 0;
    opacity: 0;
    transform: translateY(-50%) scale(0.84);
    visibility: hidden;
    transition:
      opacity 100ms ease,
      transform 160ms cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0s linear 180ms;
  }

  .search-close svg {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-width: 2;
  }

  .search-close:focus-visible,
  .search-retry:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }

  .site-header.search-active {
    grid-template-columns: auto minmax(0, 0fr) minmax(0, 1fr) auto;
  }

  .site-header.search-active > .nav-panel {
    opacity: 0;
    visibility: hidden;
    clip-path: inset(0 0 0 100%);
    transition:
      opacity 100ms ease,
      visibility 0s linear 180ms,
      clip-path 180ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .site-header.search-active .search-area {
    width: 100%;
    max-width: none;
  }

  .site-header.search-active .search-control {
    min-height: 44px;
    padding-inline-end: 3rem;
    background: var(--surface);
  }

  .site-header.search-active .search-close {
    opacity: 1;
    transform: translateY(-50%) scale(1);
    visibility: visible;
    transition:
      opacity 120ms ease 60ms,
      transform 200ms cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0s linear;
  }

  .search-dropdown[hidden] {
    display: none;
  }

  .search-dropdown {
    position: absolute;
    inset-inline: 0;
    top: calc(100% + 0.3rem);
    z-index: 40;
    box-sizing: border-box;
    max-height: min(68dvh, 640px);
    overflow: auto;
    border: 1px solid rgba(112, 104, 94, 0.22);
    border-radius: 12px;
    padding: 0.9rem;
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .search-summary {
    min-height: 1.4rem;
    margin: 0;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .search-results {
    display: grid;
    gap: 0.55rem;
    margin-top: 0.75rem;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .language-picker {
    display: inline-flex;
    flex: 0 0 auto;
    min-height: 34px;
    align-items: center;
    gap: 0.16rem;
    border: 1px solid rgba(112, 104, 94, 0.22);
    border-radius: 8px;
    padding: 0.16rem;
    background: rgba(255, 253, 248, 0.62);
    color: var(--ink);
    direction: ltr;
    font-size: 0.92rem;
    font-weight: 820;
    white-space: nowrap;
  }

  .desktop-language-picker {
    grid-column: 4;
    margin-left: -0.2rem;
  }

  .language-picker a {
    min-width: 2rem;
    min-height: 30px;
    justify-content: center;
    border-radius: 6px;
    padding: 0.22rem 0.46rem;
    color: var(--ink);
    text-decoration: none;
  }

  .language-picker a:hover,
  .language-picker a:focus-visible {
    background: rgba(104, 116, 73, 0.14);
    color: var(--tomato);
    outline: none;
  }

  .language-picker span[aria-current="page"] {
    min-width: 2rem;
    min-height: 30px;
    justify-content: center;
    border-radius: 6px;
    padding: 0.22rem 0.46rem;
    background: var(--control-accent);
    color: var(--control-on-accent);
    box-shadow: var(--control-accent-shadow);
  }

  .mobile-actions {
    display: none;
    transition: gap 220ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  :global(.search-result) {
    display: grid;
    gap: 0.32rem;
    border: 1px solid rgba(112, 104, 94, 0.18);
    border-radius: 8px;
    padding: 0.85rem;
    color: inherit;
    text-decoration: none;
  }

  :global(.search-result:hover),
  :global(.search-result:focus-visible) {
    border-color: rgba(180, 62, 47, 0.42);
    outline: none;
  }

  :global(.search-result:focus-visible) {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }

  :global(.search-result strong) {
    font-size: 1rem;
  }

  :global(.search-result-meta) {
    color: var(--olive);
    font-size: 0.8rem;
    font-weight: 780;
  }

  :global(.search-result-excerpt) {
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.45;
  }

  :global(.search-result-excerpt mark) {
