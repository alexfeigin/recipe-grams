---
// The site header every surface shares. It asks for only what a page decides:
// the line under the brand and where the language switch and navigation lead.
// Everything else — direction, the labels, the accessible names, and the link
// back to this language's landing page — it derives from the language through
// getPageContext, whose copy comes from src/i18n/ui.ts (ADR 0034).
import { languageNames } from "../i18n/ui";
import { getPageContext, type NavItem } from "../lib/pageContext";
import { sitePath, type RecipeLanguage } from "../lib/site";

type Props = {
  language: RecipeLanguage;
  brandLine: string;
  languageHref: string;
  navItems: NavItem[];
};

const { language, brandLine, languageHref, navItems } = Astro.props;

const page = getPageContext(language, import.meta.env.BASE_URL);
const labels = page.labels;
const homeHref = page.homeHref;
const homeLabel = labels.accessibility.home;
const toggleNavigationLabel = labels.accessibility.toggleNavigation;
const navLabel = labels.accessibility.mainNavigation;
const languagePickerLabel = labels.accessibility.languagePicker;
const hebrewLabel = languageNames.he;
const englishLabel = languageNames.en;
const basePath = page.basePath;
const logoHref = sitePath(basePath, "recipe-grams-logo.png");
const searchLabels = labels.search;
const searchDirection = page.direction;
---

<header
  class="site-header"
  data-site-header
  data-language={language}
  data-base-path={basePath}
>
  <a class="brand" href={homeHref} aria-label={homeLabel}>
    <img
      class="brand-mark"
      src={logoHref}
      alt=""
      width="46"
      height="46"
      decoding="async"
      aria-hidden="true"
    />
    <span>
      <strong>Recipe-Grams</strong>
      <small>{brandLine}</small>
    </span>
  </a>

  <nav
    id="main-navigation"
    class="nav-panel"
    aria-label={navLabel}
    dir={searchDirection}
  >
    {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>

  <div class="search-area" data-search-area dir={searchDirection}>
    <label class="search-control">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="10.5" cy="10.5" r="6.5"></circle>
        <path d="m16 16 4 4"></path>
      </svg>
      <input
        class="search-input"
        type="search"
        autocomplete="off"
        spellcheck="false"
        aria-label={searchLabels.title}
        aria-controls="search-results-panel"
        aria-describedby="search-status"
        aria-expanded="false"
        placeholder={searchLabels.placeholder}
        data-search-input
      />
    </label>
    <button
      class="search-close"
      type="button"
      aria-label={searchLabels.close}
      data-search-close
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="m6 6 12 12M18 6 6 18"></path>
      </svg>
    </button>

    <p
      id="search-status"
      class="visually-hidden"
      data-search-status
      role="status"
      aria-live="polite"
      aria-atomic="true"
    >
    </p>

    <section
      id="search-results-panel"
      class="search-dropdown"
      data-search-overlay
      aria-label={searchLabels.resultsLabel}
      hidden
    >
      <p class="search-summary" data-search-summary></p>
      <button class="search-retry" type="button" data-search-retry hidden>
        {searchLabels.retry}
      </button>
      <div
        class="search-results"
        data-search-results
        aria-label={searchLabels.resultsLabel}
      >
      </div>
    </section>
  </div>

  <div
    class="language-picker desktop-language-picker"
    aria-label={languagePickerLabel}
  >
    {
      language === "he" ? (
        <span aria-current="page">{hebrewLabel}</span>
      ) : (
        <a href={languageHref} data-language-switch>
          {hebrewLabel}
        </a>
      )
    }
    {
      language === "en" ? (
        <span aria-current="page">{englishLabel}</span>
      ) : (
        <a href={languageHref} data-language-switch>
          {englishLabel}
        </a>
      )
    }
  </div>

  <div class="mobile-actions">
    <div class="language-picker" aria-label={languagePickerLabel}>
      {
        language === "he" ? (
          <span aria-current="page">{hebrewLabel}</span>
        ) : (
          <a href={languageHref} data-language-switch>
            {hebrewLabel}
          </a>
        )
      }
      {
        language === "en" ? (
          <span aria-current="page">{englishLabel}</span>
        ) : (
          <a href={languageHref} data-language-switch>
            {englishLabel}
          </a>
        )
      }
    </div>

    <button
      class="menu-button"
      type="button"
      aria-label={toggleNavigationLabel}
      aria-expanded="false"
      aria-controls="main-navigation"
    >
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </button>
  </div>
</header>

<button
  class="back-to-top"
  type="button"
  aria-label={labels.accessibility.backToTop}
  data-back-to-top
  hidden
>
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <path d="m5 15 7-7 7 7"></path>
  </svg>
</button>

<script>
  import { initializeBackToTop } from "../scripts/backToTop";
  import { initializeSiteHeader } from "../scripts/siteHeader";

  const header = document.querySelector<HTMLElement>("[data-site-header]");
  const backToTop = document.querySelector<HTMLElement>("[data-back-to-top]");
  const brand = header?.querySelector<HTMLElement>(".brand");

  if (header) initializeSiteHeader(header);
  if (backToTop && brand)
    initializeBackToTop({ button: backToTop, focusTarget: brand });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    box-sizing: border-box;
    display: grid;
    direction: ltr;
    grid-template-columns:
      auto minmax(0, 1fr) minmax(6.75rem, 10rem)
      auto;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    min-height: 78px;
    margin: 0;
    padding: 0.8rem max(1rem, calc((100% - 1180px) / 2));
    background: rgba(248, 244, 236, 0.92);
    border-bottom: 1px solid rgba(112, 104, 94, 0.22);
    backdrop-filter: blur(16px);
    transition: grid-template-columns 240ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .brand {
    display: inline-flex;
    grid-column: 1;
    min-width: 0;
    align-items: center;
    gap: 0.8rem;
    color: inherit;
    text-decoration: none;
  }

  .brand-mark {
    flex: 0 0 auto;
    width: 46px;
    height: 46px;
    border-radius: 10px;
    object-fit: cover;
  }

  .brand strong,
  .brand small {
    display: block;
  }

  .brand strong {
    font-size: 1.08rem;
  }

  .brand small {
    max-width: 34vw;
    overflow: hidden;
    color: var(--muted);
    font-size: 0.82rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .menu-button {
    display: none;
    border: 0;
    padding: 0;
  }

  .menu-button:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }

  .nav-panel {
    display: flex;
    grid-column: 2;
    min-width: 0;
    align-items: center;
    justify-content: flex-end;
    gap: 0.35rem;
    margin-left: auto;
    overflow: hidden;
    opacity: 1;
    visibility: visible;
    clip-path: inset(0);
    transition:
      opacity 120ms ease,
      visibility 0s linear,
      clip-path 180ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav-panel a,
  .language-picker a,
  .language-picker span {
    display: inline-flex;
    box-sizing: border-box;
    align-items: center;
  }

  .nav-panel > a {
    flex: 0 0 auto;
    min-height: 42px;
    border-radius: 10px;
    padding: 0.65rem 0.9rem;
    color: var(--ink);
    font-weight: 720;
    text-decoration: none;
    white-space: nowrap;
  }

  .nav-panel > a:hover,
  .nav-panel > a:focus-visible {
    background: rgba(104, 116, 73, 0.15);
    outline: none;
  }

  .search-area {
    position: relative;
    display: inline-flex;
    grid-column: 3;
    min-width: 6.75rem;
    align-items: center;
    gap: 0.55rem;
  }

  .search-control {
    display: inline-flex;
    flex: 1 1 auto;
    min-width: 0;
    align-items: center;
    gap: 0.45rem;
    min-height: 34px;
    border: 1px solid rgba(112, 104, 94, 0.2);
    border-radius: 8px;
    padding: 0.18rem 0.55rem;
    background: rgba(255, 253, 248, 0.55);
    transition:
      min-height 220ms cubic-bezier(0.16, 1, 0.3, 1),
      padding-inline-end 220ms cubic-bezier(0.16, 1, 0.3, 1),
      background-color 180ms ease;
  }

  .search-control svg {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-width: 1.8;
  }

  .search-input {
    width: 100%;
    min-width: 0;
    border: 0;
    padding: 0.3rem 0;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 1rem;
    line-height: 1.2;
  }

  .search-input:focus {
    outline: none;
  }

  .search-input::-webkit-search-cancel-button {
    display: none;
    appearance: none;
  }

  .search-control:focus-within {
    border-color: rgba(180, 62, 47, 0.52);
    box-shadow: 0 0 0 3px rgba(180, 62, 47, 0.12);
  }

  .search-close,
  .search-retry {
    min-height: 42px;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 8px;
    padding: 0.5rem 0.7rem;
    background: rgba(104, 116, 73, 0.12);
    color: var(--ink);
    font: inherit;
    font-size: 0.9rem;
    font-weight: 760;
    white-space: nowrap;
    cursor: pointer;
  }

  .search-close {
    position: absolute;
    inset-inline-end: 2px;
    top: 50%;
    z-index: 1;
    display: inline-flex;
    width: 42px;
    max-width: 42px;
    overflow: hidden;
    padding-inline: 0;
    opacity: 0;
    transform: translateY(-50%) scale(0.84);
    visibility: hidden;
    transition:
      opacity 100ms ease,
      transform 160ms cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0s linear 180ms;
  }

  .search-close svg {
    flex: 0 0 auto;
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-width: 2;
  }

  .search-close:focus-visible,
  .search-retry:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }

  .site-header.search-active {
    grid-template-columns: auto minmax(0, 0fr) minmax(0, 1fr) auto;
  }

  .site-header.search-active > .nav-panel {
    opacity: 0;
    visibility: hidden;
    clip-path: inset(0 0 0 100%);
    transition:
      opacity 100ms ease,
      visibility 0s linear 180ms,
      clip-path 180ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .site-header.search-active .search-area {
    width: 100%;
    max-width: none;
  }

  .site-header.search-active .search-control {
    min-height: 44px;
    padding-inline-end: 3rem;
    background: var(--surface);
  }

  .site-header.search-active .search-close {
    opacity: 1;
    transform: translateY(-50%) scale(1);
    visibility: visible;
    transition:
      opacity 120ms ease 60ms,
      transform 200ms cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0s linear;
  }

  .search-dropdown[hidden] {
    display: none;
  }

  .search-dropdown {
    position: absolute;
    inset-inline: 0;
    top: calc(100% + 0.3rem);
    z-index: 40;
    box-sizing: border-box;
    max-height: min(68dvh, 640px);
    overflow: auto;
    border: 1px solid rgba(112, 104, 94, 0.22);
    border-radius: 12px;
    padding: 0.9rem;
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .search-summary {
    min-height: 1.4rem;
    margin: 0;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .search-results {
    display: grid;
    gap: 0.55rem;
    margin-top: 0.75rem;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .language-picker {
    display: inline-flex;
    flex: 0 0 auto;
    min-height: 34px;
    align-items: center;
    gap: 0.16rem;
    border: 1px solid rgba(112, 104, 94, 0.22);
    border-radius: 8px;
    padding: 0.16rem;
    background: rgba(255, 253, 248, 0.62);
    color: var(--ink);
    direction: ltr;
    font-size: 0.92rem;
    font-weight: 820;
    white-space: nowrap;
  }

  .desktop-language-picker {
    grid-column: 4;
    margin-left: -0.2rem;
  }

  .language-picker a {
    min-width: 2rem;
    min-height: 30px;
    justify-content: center;
    border-radius: 6px;
    padding: 0.22rem 0.46rem;
    color: var(--ink);
    text-decoration: none;
  }

  .language-picker a:hover,
  .language-picker a:focus-visible {
    background: rgba(104, 116, 73, 0.14);
    color: var(--tomato);
    outline: none;
  }

  .language-picker span[aria-current="page"] {
    min-width: 2rem;
    min-height: 30px;
    justify-content: center;
    border-radius: 6px;
    padding: 0.22rem 0.46rem;
    background: var(--control-accent);
    color: var(--control-on-accent);
    box-shadow: var(--control-accent-shadow);
  }

  .mobile-actions {
    display: none;
    transition: gap 220ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  :global(.search-result) {
    display: grid;
    gap: 0.32rem;
    border: 1px solid rgba(112, 104, 94, 0.18);
    border-radius: 8px;
    padding: 0.85rem;
    color: inherit;
    text-decoration: none;
  }

  :global(.search-result:hover),
  :global(.search-result:focus-visible) {
    border-color: rgba(180, 62, 47, 0.42);
    outline: none;
  }

  :global(.search-result:focus-visible) {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }

  :global(.search-result strong) {
    font-size: 1rem;
  }

  :global(.search-result-meta) {
    color: var(--olive);
    font-size: 0.8rem;
    font-weight: 780;
  }

  :global(.search-result-excerpt) {
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.45;
  }

  :global(.search-result-excerpt mark) {
    border-radius: 4px;
    background: rgba(180, 62, 47, 0.14);
    color: var(--ink);
  }

  .back-to-top {
    position: fixed;
    inset-inline-end: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 20;
    display: grid;
    width: 48px;
    height: 48px;
    place-items: center;
    border: 0;
    border-radius: 12px;
    padding: 0;
    background: var(--control-accent);
    color: var(--control-on-accent);
    box-shadow: 0 10px 24px
      color-mix(in srgb, var(--control-accent) 30%, transparent);
    opacity: var(--back-to-top-opacity, 0.14);
    cursor: pointer;
    transition:
      background-color 160ms ease,
      box-shadow 160ms ease,
      opacity 100ms linear,
      transform 160ms ease;
  }

  :global(html[dir="rtl"]) .back-to-top {
    inset-inline-end: max(1rem, env(safe-area-inset-left));
  }

  .back-to-top[hidden] {
    display: none;
  }

  .back-to-top svg {
    width: 25px;
    height: 25px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2.35;
  }

  .back-to-top:hover {
    background: var(--control-accent-hover);
    opacity: 1;
    transform: translateY(-2px);
  }

  .back-to-top:active {
    transform: translateY(0);
  }

  .back-to-top:focus-visible {
    opacity: 1;
    outline: none;
    box-shadow: var(--control-accent-shadow), var(--control-accent-focus-ring);
  }

  @media (max-width: 1080px) {
    .site-header {
      grid-template-columns:
        auto minmax(0, 1fr) minmax(5.8rem, 7.5rem)
        auto;
      gap: 0.65rem;
    }

    .brand {
      gap: 0.55rem;
    }

    .brand small {
      display: none;
    }

    .nav-panel {
      gap: 0.15rem;
    }

    .nav-panel > a {
      min-height: 40px;
      padding: 0.58rem 0.62rem;
      font-size: 0.92rem;
    }

    .search-area {
      min-width: 5.8rem;
    }

    .search-control {
      min-height: 32px;
      padding-inline: 0.5rem;
    }

    .language-picker {
      min-height: 32px;
      font-size: 0.88rem;
    }
  }

  @media (max-width: 880px) {
    .site-header {
      display: grid;
      grid-template-columns:
        auto minmax(8.5rem, clamp(8.5rem, 42vw, 11rem))
        auto;
      width: 100%;
      min-height: 68px;
      align-items: center;
      justify-content: space-between;
      column-gap: clamp(0.55rem, 2.4vw, 0.85rem);
      padding: 0.7rem 1rem;
    }

    .brand {
      grid-column: 1;
      grid-row: 1;
    }

    .brand span {
      display: none;
    }

    .brand-mark {
      width: 38px;
      height: 38px;
    }

    .mobile-actions {
      display: inline-flex;
      grid-column: 3;
      grid-row: 1;
      align-items: center;
      gap: 0.42rem;
      margin-left: auto;
    }

    .mobile-actions .language-picker {
      min-height: 32px;
      font-size: 0.86rem;
    }

    .menu-button {
      display: grid;
      width: 40px;
      height: 40px;
      place-content: center;
      gap: 5px;
      border-radius: 10px;
      background: var(--surface);
      box-shadow: 0 8px 24px rgba(61, 43, 28, 0.12);
      cursor: pointer;
      overflow: hidden;
      opacity: 1;
      visibility: visible;
      transition:
        width 180ms cubic-bezier(0.16, 1, 0.3, 1),
        opacity 100ms ease,
        visibility 0s linear;
    }

    .menu-button span {
      display: block;
      width: 20px;
      height: 2px;
      background: var(--ink);
    }

    .nav-panel {
      position: absolute;
      top: calc(100% + 0.55rem);
      right: 1rem;
      left: auto;
      display: none;
      width: min(15rem, calc(100vw - 2rem));
      align-items: stretch;
      justify-content: stretch;
      justify-items: stretch;
      border-radius: 14px;
      padding: 0.55rem;
      background: var(--surface);
      box-shadow: var(--shadow);
    }

    .nav-panel a {
      justify-content: flex-start;
      text-align: start;
      width: 100%;
    }

    .nav-panel > a {
      min-height: 44px;
      padding: 0.5rem 0.65rem;
      font-size: 0.95rem;
    }

    .search-area {
      grid-column: 2;
      grid-row: 1;
      width: 100%;
      min-width: 0;
      max-width: 11rem;
    }

    .search-control {
      min-height: 34px;
      padding: 0.18rem 0.55rem;
    }

    .desktop-language-picker {
      display: none;
    }

    .nav-panel.is-open {
      display: grid;
      gap: 0.2rem;
    }

    .site-header.search-active {
      grid-template-columns: auto minmax(0, 1fr) auto;
    }

    .site-header.search-active .mobile-actions {
      gap: 0;
    }

    .site-header.search-active .menu-button {
      width: 0;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition:
        width 180ms cubic-bezier(0.16, 1, 0.3, 1),
        opacity 80ms ease,
        visibility 0s linear 180ms;
    }
  }

  @media (max-width: 380px) {
    .site-header {
      grid-template-columns: auto minmax(0, 6.6rem) auto;
      column-gap: 0.48rem;
      padding-inline: 0.75rem;
    }

    .brand-mark {
      width: 34px;
      height: 34px;
    }

    .mobile-actions {
      gap: 0.32rem;
    }

    .mobile-actions .language-picker {
      font-size: 0.82rem;
    }

    .search-area {
      max-width: 6.6rem;
    }

    .search-control {
      padding-inline: 0.45rem;
    }

    .menu-button {
      width: 38px;
      height: 38px;
    }

    .nav-panel {
      right: 0.75rem;
      width: min(15rem, calc(100vw - 1.5rem));
    }
  }

  @media print {
    .back-to-top {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .nav-panel,
    .search-close,
    .search-control,
    .mobile-actions,
    .menu-button {
      transition-duration: 0.01ms;
      transition-delay: 0s;
    }
  }
</style>
