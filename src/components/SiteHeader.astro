---
import { labelsByLanguage, sitePath } from "../lib/recipePages";
import type { RecipeLanguage } from "../lib/recipePages";

type NavItem = {
  label: string;
  href: string;
};

type Props = {
  language: RecipeLanguage;
  brandLine: string;
  homeHref: string;
  languageHref: string;
  homeLabel: string;
  toggleNavigationLabel: string;
  navItems: NavItem[];
};

const {
  language,
  brandLine,
  homeHref,
  languageHref,
  homeLabel,
  toggleNavigationLabel,
  navItems,
} = Astro.props;

const navLabel = language === "he" ? "ניווט ראשי" : "Main navigation";
const languagePickerLabel = language === "he" ? "בחירת שפה" : "Language";
const hebrewLabel = "עב";
const englishLabel = "EN";
const logoHref = sitePath(import.meta.env.BASE_URL, "recipe-grams-logo.png");
const searchLabels = labelsByLanguage[language].search;
const pagefindBundle = sitePath(
  import.meta.env.BASE_URL,
  "pagefind/pagefind.js",
);
const searchDirection = language === "he" ? "rtl" : "ltr";
---

<header class="site-header">
  <a class="brand" href={homeHref} aria-label={homeLabel}>
    <img
      class="brand-mark"
      src={logoHref}
      alt=""
      width="46"
      height="46"
      decoding="async"
      aria-hidden="true"
    />
    <span>
      <strong>Recipe-Grams</strong>
      <small>{brandLine}</small>
    </span>
  </a>

  <div class="mobile-actions">
    <div class="language-picker" aria-label={languagePickerLabel}>
      {
        language === "he" ? (
          <span aria-current="page">{hebrewLabel}</span>
        ) : (
          <a href={languageHref}>{hebrewLabel}</a>
        )
      }
      <span class="language-divider" aria-hidden="true">|</span>
      {
        language === "en" ? (
          <span aria-current="page">{englishLabel}</span>
        ) : (
          <a href={languageHref}>{englishLabel}</a>
        )
      }
    </div>

    <label
      class="menu-button"
      for="nav-toggle"
      aria-label={toggleNavigationLabel}
    >
      <span></span>
      <span></span>
      <span></span>
    </label>
  </div>

  <input class="nav-toggle" type="checkbox" id="nav-toggle" />

  <nav class="nav-panel" aria-label={navLabel}>
    {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
    <label class="search-control">
      <span>{searchLabels.button}</span>
      <input
        class="search-input"
        type="search"
        autocomplete="off"
        spellcheck="false"
        aria-label={searchLabels.placeholder}
        aria-controls="search-results-panel"
        placeholder={searchLabels.placeholder}
        data-search-input
      />
    </label>
    <div class="language-picker" aria-label={languagePickerLabel}>
      {
        language === "he" ? (
          <span aria-current="page">{hebrewLabel}</span>
        ) : (
          <a href={languageHref}>{hebrewLabel}</a>
        )
      }
      <span class="language-divider" aria-hidden="true">|</span>
      {
        language === "en" ? (
          <span aria-current="page">{englishLabel}</span>
        ) : (
          <a href={languageHref}>{englishLabel}</a>
        )
      }
    </div>
  </nav>

  <script is:inline>
    if (window.location.hash === "#nav-open") {
      document.getElementById("nav-toggle")?.setAttribute("checked", "");
    }
  </script>

  <div
    class="search-overlay"
    data-search-overlay
    hidden
    role="dialog"
    aria-modal="true"
    aria-labelledby="search-title"
    dir={searchDirection}
  >
    <div class="search-panel" id="search-results-panel">
      <div class="search-header">
        <h2 id="search-title">{searchLabels.resultsLabel}</h2>
        <button class="search-close" type="button" data-search-close>
          {searchLabels.close}
        </button>
      </div>
      <p class="search-status" data-search-status></p>
      <div
        class="search-results"
        data-search-results
        aria-label={searchLabels.resultsLabel}
      >
      </div>
    </div>
  </div>

  <script
    is:inline
    define:vars={{
      language,
      pagefindBundle,
      searchLabels,
      basePath: import.meta.env.BASE_URL,
    }}
  >
    const overlay = document.querySelector("[data-search-overlay]");
    const input = document.querySelector("[data-search-input]");
    const status = document.querySelector("[data-search-status]");
    const results = document.querySelector("[data-search-results]");
    const closeButton = document.querySelector("[data-search-close]");
    let pagefindPromise;
    let lastSearchId = 0;

    function normalizeResultUrl(url) {
      const normalizedBase = basePath.endsWith("/") ? basePath : `${basePath}/`;
      if (url.startsWith(normalizedBase)) {
        return url;
      }
      return `${normalizedBase}${url.replace(/^\/+/, "")}`;
    }

    async function getPagefind() {
      pagefindPromise ??= import(pagefindBundle).then((pagefind) => {
        pagefind.init?.();
        return pagefind;
      });
      return pagefindPromise;
    }

    function showResultsLayer() {
      overlay.hidden = false;
    }

    function closeResultsLayer() {
      overlay.hidden = true;
      input.focus();
    }

    function clearResults(message) {
      results.replaceChildren();
      status.textContent = message;
    }

    function renderResults(searchResults) {
      results.replaceChildren();

      for (const result of searchResults) {
        const link = document.createElement("a");
        link.className = "search-result";
        link.href = normalizeResultUrl(result.url);

        const title = document.createElement("strong");
        title.textContent = result.meta.title ?? link.href;
        link.append(title);

        const details = [result.meta.category, result.meta.markers]
          .filter(Boolean)
          .join(" | ");
        if (details) {
          const meta = document.createElement("span");
          meta.className = "search-result-meta";
          meta.textContent = details;
          link.append(meta);
        }

        const excerpt = document.createElement("span");
        excerpt.className = "search-result-excerpt";
        excerpt.innerHTML = result.excerpt;
        link.append(excerpt);

        results.append(link);
      }
    }

    async function runSearch() {
      const query = input.value.trim();
      const searchId = ++lastSearchId;

      if (query.length < 2) {
        overlay.hidden = true;
        clearResults(searchLabels.waiting);
        return;
      }

      showResultsLayer();
      status.textContent = searchLabels.loading;
      const pagefind = await getPagefind();
      const search = await pagefind.search(query, {
        filters: { language },
      });
      const searchResults = await Promise.all(
        search.results.slice(0, 8).map((result) => result.data()),
      );

      if (searchId !== lastSearchId) {
        return;
      }

      if (searchResults.length === 0) {
        clearResults(searchLabels.empty);
        return;
      }

      status.textContent = "";
      renderResults(searchResults);
    }

    input.addEventListener("focus", () => {
      getPagefind().catch(() => {
        status.textContent = searchLabels.empty;
      });
    });
    closeButton.addEventListener("click", closeResultsLayer);
    overlay.addEventListener("click", (event) => {
      if (event.target === overlay) {
        closeResultsLayer();
      }
    });
    input.addEventListener("input", () => {
      runSearch().catch(() => {
        clearResults(searchLabels.empty);
      });
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !overlay.hidden) {
        closeResultsLayer();
      }
    });
  </script>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    direction: ltr;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    width: min(1180px, calc(100% - 2rem));
    min-height: 78px;
    margin: 0 auto;
    padding: 0.8rem 0;
    background: rgba(248, 244, 236, 0.92);
    border-bottom: 1px solid rgba(112, 104, 94, 0.22);
    backdrop-filter: blur(16px);
  }

  .brand {
    display: inline-flex;
    min-width: 0;
    align-items: center;
    gap: 0.8rem;
    color: inherit;
    text-decoration: none;
  }

  .brand-mark {
    flex: 0 0 auto;
    width: 46px;
    height: 46px;
    border-radius: 10px;
    object-fit: cover;
  }

  .brand strong,
  .brand small {
    display: block;
  }

  .brand strong {
    font-size: 1.08rem;
  }

  .brand small {
    max-width: 34vw;
    overflow: hidden;
    color: var(--muted);
    font-size: 0.82rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .nav-toggle {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .menu-button {
    display: none;
  }

  .nav-panel {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.35rem;
    margin-left: auto;
  }

  .nav-panel a,
  .language-picker a,
  .language-picker span {
    display: inline-flex;
    align-items: center;
  }

  .nav-panel > a {
    min-height: 42px;
    border-radius: 10px;
    padding: 0.65rem 0.9rem;
    color: var(--ink);
    font-weight: 720;
    text-decoration: none;
  }

  .nav-panel > a:hover,
  .nav-panel > a:focus-visible {
    background: rgba(104, 116, 73, 0.15);
    outline: none;
  }

  .search-control {
    display: inline-flex;
    min-width: min(18rem, 26vw);
    align-items: center;
    gap: 0.45rem;
    min-height: 42px;
    border: 1px solid rgba(112, 104, 94, 0.28);
    border-radius: 10px;
    padding: 0.32rem 0.55rem;
    background: rgba(255, 253, 248, 0.78);
  }

  .search-control span {
    color: var(--muted);
    font-size: 0.82rem;
    font-weight: 780;
    white-space: nowrap;
  }

  .search-input {
    width: 100%;
    min-width: 7rem;
    border: 0;
    padding: 0.3rem 0;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 0.95rem;
  }

  .search-input:focus {
    outline: none;
  }

  .search-control:focus-within {
    border-color: rgba(180, 62, 47, 0.52);
    box-shadow: 0 0 0 3px rgba(180, 62, 47, 0.12);
  }

  .language-picker {
    display: inline-flex;
    min-height: 42px;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 0 0.55rem 0.7rem;
    color: var(--muted);
    direction: ltr;
    font-size: 0.92rem;
    font-weight: 820;
    white-space: nowrap;
  }

  .language-picker a {
    border-radius: 8px;
    color: var(--ink);
    text-decoration: none;
  }

  .language-picker a:hover,
  .language-picker a:focus-visible {
    color: var(--tomato);
    outline: none;
  }

  .language-picker span[aria-current="page"] {
    color: var(--muted);
  }

  .language-divider {
    color: rgba(112, 104, 94, 0.55);
  }

  .mobile-actions {
    display: none;
  }

  .search-overlay[hidden] {
    display: none;
  }

  .search-overlay {
    position: fixed;
    inset: 0;
    z-index: 30;
    display: grid;
    place-items: start center;
    padding: clamp(4.5rem, 10vh, 7rem) 1rem 1rem;
    background: rgba(37, 33, 28, 0.34);
  }

  .search-panel {
    width: min(680px, 100%);
    max-height: min(760px, calc(100vh - 5.5rem));
    overflow: auto;
    border: 1px solid rgba(112, 104, 94, 0.22);
    border-radius: 8px;
    padding: 1rem;
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .search-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .search-header h2 {
    margin: 0;
    font-size: 1.2rem;
    letter-spacing: 0;
  }

  .search-close {
    border: 0;
    border-radius: 8px;
    padding: 0.45rem 0.65rem;
    background: rgba(104, 116, 73, 0.12);
    color: var(--ink);
    font: inherit;
    font-size: 0.9rem;
    font-weight: 760;
    cursor: pointer;
  }

  .search-status {
    min-height: 1.4rem;
    margin: 0;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .search-results {
    display: grid;
    gap: 0.55rem;
    margin-top: 0.75rem;
  }

  :global(.search-result) {
    display: grid;
    gap: 0.32rem;
    border: 1px solid rgba(112, 104, 94, 0.18);
    border-radius: 8px;
    padding: 0.85rem;
    color: inherit;
    text-decoration: none;
  }

  :global(.search-result:hover),
  :global(.search-result:focus-visible) {
    border-color: rgba(180, 62, 47, 0.42);
    outline: none;
  }

  :global(.search-result strong) {
    font-size: 1rem;
  }

  :global(.search-result-meta) {
    color: var(--olive);
    font-size: 0.8rem;
    font-weight: 780;
  }

  :global(.search-result-excerpt) {
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.45;
  }

  :global(.search-result-excerpt mark) {
    border-radius: 4px;
    background: rgba(180, 62, 47, 0.14);
    color: var(--ink);
  }

  @media (max-width: 820px) {
    .site-header {
      width: min(100% - 2rem, 1180px);
      min-height: 68px;
      gap: 0.75rem;
    }

    .brand-mark {
      width: 42px;
      height: 42px;
    }

    .brand small {
      display: none;
    }

    .mobile-actions {
      display: inline-flex;
      flex: 0 0 auto;
      align-items: center;
      gap: 0.65rem;
      margin-left: auto;
    }

    .mobile-actions .language-picker {
      min-height: 44px;
      padding: 0;
    }

    .menu-button {
      display: grid;
      width: 44px;
      height: 44px;
      place-content: center;
      gap: 5px;
      border-radius: 10px;
      background: var(--surface);
      box-shadow: 0 8px 24px rgba(61, 43, 28, 0.12);
      cursor: pointer;
    }

    .menu-button span {
      display: block;
      width: 20px;
      height: 2px;
      background: var(--ink);
    }

    .nav-panel {
      position: absolute;
      top: calc(100% + 0.55rem);
      right: 0;
      left: 0;
      display: none;
      align-items: stretch;
      border-radius: 14px;
      padding: 0.55rem;
      background: var(--surface);
      box-shadow: var(--shadow);
    }

    .nav-panel a {
      justify-content: flex-start;
      width: 100%;
    }

    .nav-panel .search-control {
      width: 100%;
      min-width: 0;
      padding: 0.55rem 0.65rem;
    }

    .nav-panel .language-picker {
      display: none;
    }

    .nav-toggle:checked ~ .nav-panel {
      display: grid;
      gap: 0.2rem;
    }
  }
</style>
