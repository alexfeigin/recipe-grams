---
import { sitePath } from "../lib/recipePages";
import type { RecipeLanguage } from "../lib/recipePages";

type NavItem = {
  label: string;
  href: string;
};

type Props = {
  language: RecipeLanguage;
  brandLine: string;
  homeHref: string;
  languageHref: string;
  homeLabel: string;
  toggleNavigationLabel: string;
  navItems: NavItem[];
};

const {
  language,
  brandLine,
  homeHref,
  languageHref,
  homeLabel,
  toggleNavigationLabel,
  navItems,
} = Astro.props;

const navLabel = language === "he" ? "ניווט ראשי" : "Main navigation";
const languagePickerLabel = language === "he" ? "בחירת שפה" : "Language";
const hebrewLabel = "עב";
const englishLabel = "EN";
const logoHref = sitePath(import.meta.env.BASE_URL, "recipe-grams-logo.png");
---

<header class="site-header">
  <a class="brand" href={homeHref} aria-label={homeLabel}>
    <img
      class="brand-mark"
      src={logoHref}
      alt=""
      width="46"
      height="46"
      decoding="async"
      aria-hidden="true"
    />
    <span>
      <strong>Recipe-Grams</strong>
      <small>{brandLine}</small>
    </span>
  </a>

  <div class="mobile-actions">
    <div class="language-picker" aria-label={languagePickerLabel}>
      {
        language === "he" ? (
          <span aria-current="page">{hebrewLabel}</span>
        ) : (
          <a href={languageHref}>{hebrewLabel}</a>
        )
      }
      <span class="language-divider" aria-hidden="true">|</span>
      {
        language === "en" ? (
          <span aria-current="page">{englishLabel}</span>
        ) : (
          <a href={languageHref}>{englishLabel}</a>
        )
      }
    </div>

    <label
      class="menu-button"
      for="nav-toggle"
      aria-label={toggleNavigationLabel}
    >
      <span></span>
      <span></span>
      <span></span>
    </label>
  </div>

  <input class="nav-toggle" type="checkbox" id="nav-toggle" />

  <nav class="nav-panel" aria-label={navLabel}>
    {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
    <div class="language-picker" aria-label={languagePickerLabel}>
      {
        language === "he" ? (
          <span aria-current="page">{hebrewLabel}</span>
        ) : (
          <a href={languageHref}>{hebrewLabel}</a>
        )
      }
      <span class="language-divider" aria-hidden="true">|</span>
      {
        language === "en" ? (
          <span aria-current="page">{englishLabel}</span>
        ) : (
          <a href={languageHref}>{englishLabel}</a>
        )
      }
    </div>
  </nav>

  <script is:inline>
    if (window.location.hash === "#nav-open") {
      document.getElementById("nav-toggle")?.setAttribute("checked", "");
    }
  </script>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    direction: ltr;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    width: min(1180px, calc(100% - 2rem));
    min-height: 78px;
    margin: 0 auto;
    padding: 0.8rem 0;
    background: rgba(248, 244, 236, 0.92);
    border-bottom: 1px solid rgba(112, 104, 94, 0.22);
    backdrop-filter: blur(16px);
  }

  .brand {
    display: inline-flex;
    min-width: 0;
    align-items: center;
    gap: 0.8rem;
    color: inherit;
    text-decoration: none;
  }

  .brand-mark {
    flex: 0 0 auto;
    width: 46px;
    height: 46px;
    border-radius: 10px;
    object-fit: cover;
  }

  .brand strong,
  .brand small {
    display: block;
  }

  .brand strong {
    font-size: 1.08rem;
  }

  .brand small {
    max-width: 34vw;
    overflow: hidden;
    color: var(--muted);
    font-size: 0.82rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .nav-toggle {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .menu-button {
    display: none;
  }

  .nav-panel {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.35rem;
    margin-left: auto;
  }

  .nav-panel a,
  .language-picker a,
  .language-picker span {
    display: inline-flex;
    align-items: center;
  }

  .nav-panel > a {
    min-height: 42px;
    border-radius: 10px;
    padding: 0.65rem 0.9rem;
    color: var(--ink);
    font-weight: 720;
    text-decoration: none;
  }

  .nav-panel > a:hover,
  .nav-panel > a:focus-visible {
    background: rgba(104, 116, 73, 0.15);
    outline: none;
  }

  .language-picker {
    display: inline-flex;
    min-height: 42px;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 0 0.55rem 0.7rem;
    color: var(--muted);
    direction: ltr;
    font-size: 0.92rem;
    font-weight: 820;
    white-space: nowrap;
  }

  .language-picker a {
    border-radius: 8px;
    color: var(--ink);
    text-decoration: none;
  }

  .language-picker a:hover,
  .language-picker a:focus-visible {
    color: var(--tomato);
    outline: none;
  }

  .language-picker span[aria-current="page"] {
    color: var(--muted);
  }

  .language-divider {
    color: rgba(112, 104, 94, 0.55);
  }

  .mobile-actions {
    display: none;
  }

  @media (max-width: 820px) {
    .site-header {
      width: min(100% - 2rem, 1180px);
      min-height: 68px;
      gap: 0.75rem;
    }

    .brand-mark {
      width: 42px;
      height: 42px;
    }

    .brand small {
      display: none;
    }

    .mobile-actions {
      display: inline-flex;
      flex: 0 0 auto;
      align-items: center;
      gap: 0.65rem;
      margin-left: auto;
    }

    .mobile-actions .language-picker {
      min-height: 44px;
      padding: 0;
    }

    .menu-button {
      display: grid;
      width: 44px;
      height: 44px;
      place-content: center;
      gap: 5px;
      border-radius: 10px;
      background: var(--surface);
      box-shadow: 0 8px 24px rgba(61, 43, 28, 0.12);
      cursor: pointer;
    }

    .menu-button span {
      display: block;
      width: 20px;
      height: 2px;
      background: var(--ink);
    }

    .nav-panel {
      position: absolute;
      top: calc(100% + 0.55rem);
      right: 0;
      left: 0;
      display: none;
      align-items: stretch;
      border-radius: 14px;
      padding: 0.55rem;
      background: var(--surface);
      box-shadow: var(--shadow);
    }

    .nav-panel a {
      justify-content: flex-start;
      width: 100%;
    }

    .nav-panel .language-picker {
      display: none;
    }

    .nav-toggle:checked ~ .nav-panel {
      display: grid;
      gap: 0.2rem;
    }
  }
</style>
