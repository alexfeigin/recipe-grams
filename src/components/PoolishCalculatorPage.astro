---
// Poolish calculator page for one language: the form and the panel its weights
// are written into. The browser behavior belongs to
// src/scripts/poolishCalculatorPage.ts, which is handed the rendered
// calculator, and the arithmetic to calculatePoolish in
// src/lib/poolishCalculator.ts, the TypeScript port of poolish_calc.sh. The
// page is noindex and unlinked from navigation, and all of its copy lives in
// src/i18n/calculator.ts so the two languages stay in step (ADR 0034). The
// document shell, header, and language-derived setup belong to SitePage.
import SitePage from "../layouts/SitePage.astro";
import { calculatorLabels } from "../i18n/calculator";
import { getPageContext } from "../lib/pageContext";
import { sitePath } from "../lib/site";
import type { RecipeLanguage } from "../lib/site";

type Props = {
  language: RecipeLanguage;
};

const page = getPageContext(Astro.props.language, import.meta.env.BASE_URL);
const language = page.language;
const text = calculatorLabels[language];
const calculatorHref = sitePath(
  page.basePath,
  language === "he" ? "he/poolish/" : "poolish/",
);
// The language switch stays on the calculator; the reader's mode is added to
// the link in the browser, where the query string is known.
const languageHref = sitePath(
  page.basePath,
  page.alternateLanguage === "he" ? "he/poolish/" : "poolish/",
);
const zeroGrams = `0${text.gramUnit}`;
---

<SitePage
  language={language}
  title={`${text.pageTitle} | Recipe-Grams`}
  description={text.pageDescription}
  pageHref={calculatorHref}
  canonical={true}
  noindex={true}
  socialImage={{ source: "pizza.jpg", alt: text.imageAlt }}
  brandLine={text.brandLine}
  languageHref={languageHref}
  navItems={[{ label: text.homeLabel, href: page.homeHref }]}
>
  <main
    class="calculator-shell"
    data-poolish-calculator
    data-language={language}
  >
    <section class="tool-intro" aria-labelledby="page-title">
      <div>
        <h1 id="page-title">{text.pageTitle}</h1>
        <p>{text.intro}</p>
      </div>
    </section>

    <section class="calculator-grid" aria-label={text.calculatorLabel}>
      <form class="input-panel" data-calculator-form>
        <fieldset class="mode-switch">
          <legend>{text.modeLegend}</legend>
          <label>
            <input
              type="radio"
              name="mode"
              value="generic"
              checked
              data-mode-input
            />
            <span>{text.genericMode}</span>
          </label>
          <label>
            <input type="radio" name="mode" value="pizza" data-mode-input />
            <span>{text.pizzaMode}</span>
          </label>
        </fieldset>

        <div class="pizza-controls" data-pizza-controls hidden>
          <label>
            <span>{text.pizzaCount}</span>
            <input
              type="number"
              min="1"
              step="1"
              value="3"
              inputmode="numeric"
              data-field="pizzaCount"
            />
          </label>
          <p>
            {text.pizzaHelperPrefix}{" "}
            <strong>{text.pizzaHelperStrong}</strong>.{" "}
            {text.pizzaHelperSuffix}
          </p>
        </div>

        <div class="field-grid" data-generic-controls>
          <label>
            <span>{text.fields.desiredDough}</span>
            <input
              type="number"
              min="1"
              step="1"
              value="1700"
              inputmode="decimal"
              data-field="desiredDough"
            />
          </label>
          <label>
            <span>{text.fields.hydration}</span>
            <input
              type="number"
              min="0"
              step="0.01"
              value="0.70"
              inputmode="decimal"
              data-field="hydration"
            />
          </label>
          <label>
            <span>{text.fields.poolishShare}</span>
            <input
              type="number"
              min="0"
              max="1"
              step="0.001"
              value="0.667"
              inputmode="decimal"
              data-field="poolishShare"
            />
          </label>
          <label>
            <span>{text.fields.poolishHydration}</span>
            <input
              type="number"
              min="0"
              step="0.01"
              value="1.00"
              inputmode="decimal"
              data-field="poolishHydration"
            />
          </label>
          <label>
            <span>{text.fields.poolishYeast}</span>
            <input
              type="number"
              min="0"
              step="0.001"
              value="0.013"
              inputmode="decimal"
              data-field="poolishYeast"
            />
          </label>
          <label>
            <span>{text.fields.restYeast}</span>
            <input
              type="number"
              min="0"
              step="0.001"
              value="0"
              inputmode="decimal"
              data-field="restYeast"
            />
          </label>
          <label>
            <span>{text.fields.salt}</span>
            <input
              type="number"
              min="0"
              step="0.001"
              value="0.027"
              inputmode="decimal"
              data-field="salt"
            />
          </label>
        </div>

        <dl class="preset-list" data-preset-list hidden>
          <div>
            <dt>{text.fields.hydration}</dt>
            <dd>{text.preset.hydration}</dd>
          </div>
          <div>
            <dt>{text.fields.poolishShare}</dt>
            <dd>{text.preset.poolishShare}</dd>
          </div>
          <div>
            <dt>{text.fields.poolishYeast}</dt>
            <dd>{text.preset.poolishYeast}</dd>
          </div>
          <div>
            <dt>{text.fields.salt}</dt>
            <dd>{text.preset.salt}</dd>
          </div>
        </dl>
      </form>

      <section class="results-panel" aria-live="polite">
        <div class="result-summary">
          <span>{text.summaries.totalFlour}</span>
          <strong data-output="totalFlour">{zeroGrams}</strong>
        </div>
        <div class="result-summary">
          <span>{text.summaries.totalWater}</span>
          <strong data-output="totalWater">{zeroGrams}</strong>
        </div>
        <div class="result-summary">
          <span>{text.summaries.targetDough}</span>
          <strong data-output="targetDough">{zeroGrams}</strong>
        </div>

        <div class="phase-grid">
          <article>
            <h2>{text.phases.poolish}</h2>
            <dl>
              <div>
                <dt>{text.phases.flour}</dt>
                <dd data-output="poolishFlour">{zeroGrams}</dd>
              </div>
              <div>
                <dt>{text.phases.water}</dt>
                <dd data-output="poolishWater">{zeroGrams}</dd>
              </div>
              <div>
                <dt>{text.phases.yeast}</dt>
                <dd data-output="poolishYeast">{zeroGrams}</dd>
              </div>
            </dl>
          </article>

          <article>
            <h2>{text.phases.finalDough}</h2>
            <dl>
              <div>
                <dt>{text.phases.flour}</dt>
                <dd data-output="restFlour">{zeroGrams}</dd>
              </div>
              <div>
                <dt>{text.phases.water}</dt>
                <dd data-output="restWater">{zeroGrams}</dd>
              </div>
              <div>
                <dt>{text.phases.yeast}</dt>
                <dd data-output="restYeast">{zeroGrams}</dd>
              </div>
              <div>
                <dt>{text.phases.salt}</dt>
                <dd data-output="salt">{zeroGrams}</dd>
              </div>
            </dl>
          </article>
        </div>

        <button class="copy-button" type="button" data-copy-button disabled>
          {text.copyButton}
        </button>
        <p class="copy-status" data-copy-status aria-live="polite"></p>
        <p class="validation-message" data-validation-message></p>
      </section>
    </section>
  </main>

  <script>
    import { initializePoolishCalculator } from "../scripts/poolishCalculatorPage";

    const calculator = document.querySelector<HTMLElement>(
      "[data-poolish-calculator]",
    );

    if (calculator) initializePoolishCalculator(calculator);
  </script>
</SitePage>

<style>
  :root {
    /* Page-only accents for the calculator's phase, mode, and note surfaces. */
    --tomato-dark: #7f2f24;
    --olive-dark: #40492c;
    --blue: #395f6f;
    --shadow: 0 18px 48px rgba(61, 43, 28, 0.14);
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    min-width: 320px;
    overflow-x: hidden;
    background:
      linear-gradient(135deg, rgba(104, 116, 73, 0.14), transparent 28rem),
      linear-gradient(180deg, #fbf7ef 0%, var(--paper) 52%, #efe7d9 100%);
    color: var(--ink);
  }

  button,
  input {
    font: inherit;
  }

  .calculator-shell {
    width: min(1180px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 2.2rem 0 4rem;
  }

  .tool-intro {
    padding: 1.8rem 0 1.5rem;
  }

  .tool-intro h1 {
    max-width: 10ch;
    margin: 0;
    font-size: clamp(2.8rem, 8vw, 5.8rem);
    line-height: 0.92;
    letter-spacing: 0;
  }

  .tool-intro p {
    max-width: 64ch;
    margin: 1rem 0 0;
    color: #4f463c;
    font-size: clamp(1.02rem, 1.8vw, 1.2rem);
    line-height: 1.5;
  }

  .result-summary span {
    display: block;
    color: var(--olive-dark);
    font-size: 0.78rem;
    font-weight: 820;
  }

  .calculator-grid {
    display: grid;
    grid-template-columns: minmax(300px, 0.82fr) minmax(0, 1.18fr);
    gap: 1rem;
    align-items: start;
  }

  .input-panel,
  .results-panel,
  .phase-grid article {
    border-radius: 8px;
    background: rgba(255, 253, 248, 0.92);
    box-shadow: 0 14px 32px rgba(61, 43, 28, 0.12);
  }

  .input-panel {
    display: grid;
    gap: 1rem;
    padding: 1rem;
  }

  .mode-switch {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.16rem;
    min-width: 0;
    margin: 0;
    border: 1px solid rgba(112, 104, 94, 0.22);
    border-radius: 8px;
    padding: 0.16rem;
    background: rgba(255, 253, 248, 0.62);
  }

  .mode-switch legend {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  .mode-switch label {
    min-width: 0;
    cursor: pointer;
  }

  .mode-switch input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .mode-switch span {
    display: grid;
    min-height: 42px;
    place-items: center;
    border-radius: 6px;
    padding: 0.55rem;
    color: var(--ink);
    font-weight: 850;
    text-align: center;
    cursor: pointer;
    pointer-events: none;
  }

  .mode-switch input:checked + span {
    background: var(--control-accent);
    color: var(--control-on-accent);
    box-shadow: var(--control-accent-shadow);
  }

  .mode-switch input:focus-visible + span,
  input:focus-visible {
    outline: 3px solid var(--control-accent-focus-color);
    outline-offset: 2px;
  }

  .field-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem;
  }

  .field-grid[hidden],
  .pizza-controls[hidden],
  .preset-list[hidden] {
    display: none;
  }

  label {
    display: grid;
    gap: 0.35rem;
    min-width: 0;
  }

  label span {
    color: var(--muted);
    font-size: 0.82rem;
    font-weight: 760;
  }

  input[type="number"] {
    width: 100%;
    min-height: 44px;
    border: 1px solid rgba(112, 104, 94, 0.32);
    border-radius: 8px;
    padding: 0.65rem 0.75rem;
    background: #fffdf8;
    color: var(--ink);
  }

  input[type="number"]:focus {
    border-color: rgba(180, 62, 47, 0.55);
    outline: none;
    box-shadow: 0 0 0 3px rgba(180, 62, 47, 0.12);
  }

  .pizza-controls {
    display: grid;
    gap: 0.75rem;
  }

  .pizza-controls p {
    margin: 0;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.45;
  }

  .preset-list {
    display: grid;
    gap: 0.6rem;
    margin: 0;
  }

  .preset-list div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-top: 1px solid rgba(112, 104, 94, 0.18);
    padding-top: 0.6rem;
  }

  .preset-list dt,
  .preset-list dd {
    margin: 0;
  }

  .preset-list dt {
    color: var(--muted);
  }

  .preset-list dd {
    font-weight: 820;
    text-align: right;
  }

  .results-panel {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    padding: 1rem;
  }

  .result-summary {
    min-width: 0;
    border-radius: 8px;
    padding: 1rem;
    background: #efe7d9;
  }

  .result-summary strong {
    display: block;
    margin-top: 0.3rem;
    color: var(--blue);
    font-size: clamp(1.55rem, 4vw, 2.4rem);
    line-height: 1;
  }

  .phase-grid {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .phase-grid article {
    box-shadow: none;
    border: 1px solid rgba(112, 104, 94, 0.2);
    padding: 1rem;
  }

  .phase-grid h2 {
    margin: 0 0 1rem;
    font-size: clamp(1.35rem, 3vw, 2rem);
    line-height: 1.1;
  }

  .phase-grid dl {
    display: grid;
    gap: 0.75rem;
    margin: 0;
  }

  .phase-grid div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    border-top: 1px solid rgba(112, 104, 94, 0.18);
    padding-top: 0.75rem;
  }

  .phase-grid dt,
  .phase-grid dd {
    margin: 0;
  }

  .phase-grid dt {
    color: var(--muted);
    font-weight: 720;
  }

  .phase-grid dd {
    color: var(--blue);
    font-size: 1.35rem;
    font-weight: 880;
  }

  .validation-message {
    grid-column: 1 / -1;
    min-height: 1.4em;
    margin: 0;
    color: var(--tomato-dark);
    font-weight: 760;
  }

  .copy-button {
    grid-column: 1 / -1;
    justify-self: start;
    min-height: 42px;
    border: 0;
    border-radius: 6px;
    padding: 0.7rem 1rem;
    background: var(--control-accent);
    color: var(--control-on-accent);
    font-weight: 850;
    box-shadow: var(--control-accent-shadow);
    cursor: pointer;
  }

  .copy-button:hover:enabled,
  .copy-button:focus-visible {
    background: var(--control-accent-hover);
    outline: none;
  }

  .copy-button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    box-shadow: none;
  }

  .copy-button:focus-visible {
    box-shadow: var(--control-accent-shadow), var(--control-accent-focus-ring);
  }

  .copy-status {
    grid-column: 1 / -1;
    min-height: 1.4em;
    margin: -0.6rem 0 0;
    color: var(--olive-dark);
    font-weight: 760;
  }

  @media (max-width: 820px) {
    .calculator-grid,
    .phase-grid {
      grid-template-columns: 1fr;
    }

    .tool-intro {
      padding-top: 1rem;
    }
  }

  @media (max-width: 640px) {
    .calculator-shell {
      width: min(100% - 1rem, 1180px);
      padding-top: 1.2rem;
    }

    .tool-intro h1 {
      max-width: 8ch;
    }

    .field-grid,
    .results-panel {
      grid-template-columns: 1fr;
    }

    .phase-grid div,
    .preset-list div {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.25rem;
    }

    .preset-list dd {
      text-align: left;
    }
  }
</style>
