---
import { sitePath } from "../lib/recipePages";

const basePath = import.meta.env.BASE_URL;
---

<link rel="icon" href={sitePath(basePath, "favicon.ico")} sizes="any" />
<link
  rel="icon"
  href={sitePath(basePath, "favicon-32x32.png")}
  type="image/png"
  sizes="32x32"
/>
<link
  rel="icon"
  href={sitePath(basePath, "favicon-16x16.png")}
  type="image/png"
  sizes="16x16"
/>
<link
  rel="apple-touch-icon"
  href={sitePath(basePath, "apple-touch-icon.png")}
/>
<meta name="theme-color" content="#b43e2f" />
