---
import FaviconLinks from "./FaviconLinks.astro";
import SiteHeader from "./SiteHeader.astro";
import { getLandingPageData, sitePath } from "../lib/recipePages";
import type { RecipeLanguage } from "../lib/recipePages";

type Props = {
  language: RecipeLanguage;
};

const basePath = import.meta.env.BASE_URL;
const data = getLandingPageData(Astro.props.language, basePath);
const homeHref =
  data.language === "he" ? sitePath(basePath, "he/") : sitePath(basePath, "");
const logoHref = sitePath(basePath, "recipe-grams-logo.png");
const placeholderLogoHref = sitePath(
  basePath,
  "recipe-grams-card-placeholder.png",
);
const navItems = data.categorySections.map((section) => ({
  label: section.label,
  href: `#${section.id}`,
}));
---

<html lang={data.language} dir={data.direction}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={data.labels.pageDescription} />
    <FaviconLinks />
    <title>{data.labels.pageTitle}</title>
  </head>
  <body>
    <!--
      THESIS: Recipe-Grams opens as a real recipe index, refusing a blog hero or marketing pitch.
      OWN-WORLD: warm kitchen paper, tomato and olive accents, steel rules, compact photo-led recipe cards.
      STORY: readers can browse localized categories, recognize recipe pairs, switch language, and open generated pages.
      FIRST VIEWPORT: shared navbar and language switch sit above a dense browse header and the first real category section.
      FORM: issue #6 localized catalog browse surface; seed key: ticket-6-real-catalog.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
    -->
    <SiteHeader
      language={data.language}
      brandLine={data.labels.brandLine}
      homeHref={homeHref}
      languageHref={data.alternateHref}
      homeLabel={data.labels.accessibility.home}
      toggleNavigationLabel={data.labels.accessibility.toggleNavigation}
      navItems={navItems}
    />

    <main>
      <section class="browse-hero" aria-labelledby="page-title">
        <div class="hero-copy">
          <h1 id="page-title">{data.labels.hero.title}</h1>
          <p>{data.labels.hero.description}</p>
        </div>

        <div
          class="browse-tools"
          aria-label={data.labels.accessibility.browseSummary}
        >
          <div>
            <span>{data.recipePairCount}</span>
            {data.labels.hero.recipeCount}
          </div>
          <div>
            <span>{data.categoryCount}</span>
            {data.labels.hero.categoryCount}
          </div>
          <div>
            <span>100%</span>
            {data.labels.hero.gramFirst}
          </div>
        </div>
      </section>

      <section
        class="recipe-board"
        id="categories"
        aria-labelledby="browse-title"
      >
        <div class="section-heading">
          <h2 id="browse-title">{data.labels.sections.title}</h2>
          <p>{data.labels.sections.description}</p>
        </div>

        <div class="category-stack">
          {
            data.categorySections.map((section) => (
              <section
                class="category-section"
                id={section.id}
                aria-labelledby={`${section.id}-title`}
              >
                <div class="category-heading">
                  <h3 id={`${section.id}-title`}>{section.label}</h3>
                  <p>{section.description}</p>
                </div>

                <div class="recipe-grid">
                  {section.recipes.map((recipe) => (
                    <article class="recipe-card">
                      <a
                        href={recipe.href}
                        aria-label={`${data.labels.accessibility.openRecipe} ${recipe.title}`}
                      >
                        {recipe.image && (
                          <img
                            src={sitePath(basePath, recipe.image)}
                            alt={`${recipe.title} ${data.labels.accessibility.recipePhoto}`}
                            loading="lazy"
                          />
                        )}
                        {!recipe.image && (
                          <div class="image-placeholder" aria-hidden="true">
                            <img
                              src={placeholderLogoHref}
                              alt=""
                              loading="lazy"
                            />
                          </div>
                        )}
                        <div class="card-body">
                          <div class="card-meta">
                            <span>{section.label}</span>
                            <span>{recipe.slug.replaceAll("_", " ")}</span>
                          </div>
                          <h4>{recipe.title}</h4>
                          <p>{recipe.description}</p>
                          {recipe.markerIds.length > 0 && (
                            <div class="markers">
                              {recipe.markerIds.map((markerId) => (
                                <span>
                                  {data.labels.markerLabels[markerId]}
                                </span>
                              ))}
                            </div>
                          )}
                        </div>
                      </a>
                    </article>
                  ))}
                </div>
              </section>
            ))
          }
        </div>
      </section>
    </main>
  </body>
</html>

<style>
  :root {
    color-scheme: light;
    --paper: #f8f4ec;
    --surface: #fffdf8;
    --ink: #25211c;
    --muted: #70685e;
    --tomato: #b43e2f;
    --olive: #687449;
    --steel: #d8d0c3;
    --shadow: 0 18px 48px rgba(61, 43, 28, 0.16);
    font-family:
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    min-width: 320px;
    overflow-x: hidden;
    background:
      radial-gradient(
        circle at top left,
        rgba(180, 62, 47, 0.13),
        transparent 32rem
      ),
      linear-gradient(180deg, #fbf7ef 0%, var(--paper) 44%, #efe7d9 100%);
    color: var(--ink);
  }

  a {
    color: inherit;
  }

  main {
    width: min(1180px, calc(100% - 2rem));
    margin: 0 auto;
    padding: 2.2rem 0 4rem;
  }

  .browse-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(280px, 0.8fr);
    gap: 2rem;
    align-items: end;
    padding: 2.4rem 0 1.6rem;
  }

  .hero-copy h1 {
    max-width: 8ch;
    margin: 0;
    font-size: clamp(3rem, 9vw, 6rem);
    line-height: 0.9;
    letter-spacing: 0;
  }

  .hero-copy p {
    max-width: 58ch;
    margin: 1.25rem 0 0;
    color: #4f463c;
    font-size: clamp(1.05rem, 2vw, 1.24rem);
    line-height: 1.55;
  }

  .browse-tools {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    overflow: hidden;
    border-radius: 14px;
    background: rgba(255, 253, 248, 0.86);
    box-shadow: var(--shadow);
  }

  .browse-tools div {
    min-width: 0;
    padding: 1rem;
    color: var(--muted);
    font-size: 0.82rem;
    line-height: 1.2;
  }

  .browse-tools div + div {
    border-inline-start: 1px solid rgba(112, 104, 94, 0.2);
  }

  .browse-tools span {
    display: block;
    margin-bottom: 0.25rem;
    color: var(--ink);
    font-size: 1.55rem;
    font-weight: 850;
  }

  .recipe-board {
    padding-top: 1.2rem;
  }

  .section-heading,
  .category-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 1rem;
  }

  .section-heading h2,
  .category-heading h3 {
    margin: 0;
    line-height: 1;
  }

  .section-heading h2 {
    font-size: clamp(1.65rem, 4vw, 2.6rem);
  }

  .category-heading h3 {
    font-size: clamp(1.35rem, 3vw, 2rem);
  }

  .section-heading p,
  .category-heading p {
    max-width: 42ch;
    margin: 0;
    color: var(--muted);
    line-height: 1.45;
  }

  .category-stack {
    display: grid;
    gap: 2rem;
  }

  .category-section {
    scroll-margin-block-start: 104px;
    padding-top: 1rem;
  }

  .recipe-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
    gap: 1rem;
  }

  .recipe-card {
    min-width: 0;
    overflow: hidden;
    border-radius: 14px;
    background: var(--surface);
    box-shadow: 0 14px 32px rgba(61, 43, 28, 0.13);
  }

  .recipe-card a {
    display: grid;
    grid-template-rows: 176px 1fr;
    min-height: 100%;
    text-decoration: none;
  }

  .recipe-card > a > img,
  .image-placeholder {
    width: 100%;
    height: 176px;
    background: #d8d0c3;
  }

  .recipe-card > a > img {
    object-fit: cover;
  }

  .image-placeholder {
    position: relative;
    overflow: hidden;
    background:
      linear-gradient(135deg, rgba(104, 116, 73, 0.24), transparent), #eee5d6;
  }

  .image-placeholder img {
    position: absolute;
    top: 50%;
    left: 50%;
    display: block;
    width: auto;
    height: auto;
    max-width: 85%;
    max-height: 85%;
    transform: translate(-50%, -50%);
    object-fit: contain;
  }

  .card-body {
    display: grid;
    gap: 0.75rem;
    padding: 1rem;
  }

  .card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    color: var(--olive);
    font-size: 0.78rem;
    font-weight: 820;
  }

  .card-meta span + span::before {
    content: "/";
    margin-inline-end: 0.45rem;
    color: var(--steel);
  }

  .recipe-card h4 {
    margin: 0;
    font-size: 1.18rem;
    line-height: 1.15;
  }

  .recipe-card p {
    margin: 0;
    color: #5b534b;
    font-size: 0.94rem;
    line-height: 1.45;
  }

  .markers {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    align-self: end;
  }

  .markers span {
    border-radius: 999px;
    padding: 0.35rem 0.55rem;
    background: rgba(180, 62, 47, 0.12);
    color: #7f2f24;
    font-size: 0.75rem;
    font-weight: 800;
  }

  @media (max-width: 640px) {
    main {
      width: min(100% - 2rem, 1180px);
      padding-top: 1.2rem;
    }

    .browse-hero {
      grid-template-columns: 1fr;
      gap: 1.2rem;
      padding-top: 1rem;
    }

    .hero-copy h1 {
      max-width: 7ch;
    }

    .section-heading,
    .category-heading {
      display: block;
    }

    .section-heading p,
    .category-heading p {
      margin-top: 0.7rem;
    }

    .recipe-grid {
      grid-template-columns: 1fr;
    }

    .category-section {
      scroll-margin-block-start: 92px;
    }

    .recipe-card a {
      grid-template-rows: 188px 1fr;
    }

    .recipe-card > a > img,
    .image-placeholder {
      height: 188px;
    }
  }
</style>
