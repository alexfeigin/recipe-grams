---
import FaviconLinks from "../components/FaviconLinks.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SocialMeta from "../components/SocialMeta.astro";
import "../styles/design-tokens.css";
import { getPageContext, type NavItem } from "../lib/pageContext";
import { sitePath, type RecipeLanguage } from "../lib/site";

export type SocialImage = {
  source: string;
  alt: string;
  width?: number;
  height?: number;
  type?: string;
};

type Props = {
  language: RecipeLanguage;
  title: string;
  description: string;
  pageHref: string;
  canonical: boolean;
  noindex?: boolean;
  socialImage: SocialImage;
  socialType?: "website" | "article";
  brandLine: string;
  languageHref: string;
  navItems: NavItem[];
};

const {
  language,
  title,
  description,
  pageHref,
  canonical,
  noindex = false,
  socialImage,
  socialType = "website",
  brandLine,
  languageHref,
  navItems,
} = Astro.props;

const page = getPageContext(language, import.meta.env.BASE_URL);
const siteOrigin = Astro.site ?? Astro.url;
const pageUrl = new URL(pageHref, siteOrigin).href;
const socialImageUrl = new URL(
  sitePath(page.basePath, socialImage.source),
  siteOrigin,
).href;
---

<html lang={page.language} dir={page.direction}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <SocialMeta
      title={title}
      description={description}
      url={pageUrl}
      image={socialImageUrl}
      imageAlt={socialImage.alt}
      locale={page.locale}
      type={socialType}
      imageWidth={socialImage.width}
      imageHeight={socialImage.height}
      imageType={socialImage.type}
    />
    <slot name="head" />
    {canonical && <link rel="canonical" href={pageUrl} />}
    {noindex && <meta name="robots" content="noindex" />}
    <FaviconLinks />
    <title>{title}</title>
  </head>
  <body>
    <SiteHeader
      language={page.language}
      brandLine={brandLine}
      languageHref={languageHref}
      navItems={navItems}
    />

    <slot />
  </body>
</html>

<style>
  * {
    box-sizing: border-box;
  }
</style>
