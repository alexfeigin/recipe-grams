{
  "name": "recipe-grams",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test:links": "node --test scripts/generated-links.test.mjs",
    "verify:links": "node scripts/verify-generated-links.mjs",
    "verify:calculator:browser": "playwright test scripts/verify-calculator-browser.spec.mjs --reporter=line --output=.astro/calculator-test-results",
    "verify:search:browser": "playwright test scripts/verify-search-browser.spec.mjs --reporter=line --output=.astro/search-test-results",
    "verify:navigation:browser": "playwright test scripts/verify-navigation-browser.spec.mjs --reporter=line --output=.astro/navigation-test-results",
    "verify:issue5": "node scripts/verify-issue-5.mjs",
    "verify:issue6": "node scripts/verify-issue-6.mjs",
    "verify:issue7": "node scripts/verify-issue-7.mjs",
    "verify:issue7:browser": "playwright test scripts/verify-issue-7-browser.spec.mjs --reporter=line",
    "verify:issue8:browser": "playwright test scripts/verify-issue-8-browser.spec.mjs --reporter=line"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-satteri": "^0.3.5",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "astro": "^7.2.0",
    "pagefind": "^1.5.2",
    "parse5": "^7.3.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3"
  }
}
