{
  "name": "recipe-grams",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.20.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test:links": "node --test scripts/generated-links.test.mjs",
    "test:recipe-links": "node --test scripts/recipe-links.test.mjs",
    "test:catalog-intent": "node --test scripts/catalog-intent.test.mjs",
    "test:poolish-calculation": "node --test scripts/poolish-calculation.test.mjs",
    "test:preview": "node --test scripts/preview-server.test.mjs",
    "verify": "node scripts/verify-site.mjs",
    "verify:pure": "npm run test:links && npm run test:recipe-links && npm run test:catalog-intent && npm run test:poolish-calculation",
    "verify:generated": "npm run verify:recipes && npm run verify:catalog && npm run verify:navigation && npm run verify:links && npm run verify:search-index",
    "verify:recipes": "node scripts/verify-recipe-pages.mjs",
    "verify:catalog": "node scripts/verify-catalog.mjs",
    "verify:navigation": "node scripts/verify-navigation.mjs",
    "verify:links": "node scripts/verify-generated-links.mjs",
    "verify:search-index": "node scripts/verify-search-index.mjs",
    "verify:browser": "playwright test",
    "verify:recipe-flows:browser": "playwright test scripts/verify-recipe-flows-browser.spec.mjs",
    "verify:search:browser": "playwright test scripts/verify-search-browser.spec.mjs",
    "verify:search-content:browser": "playwright test scripts/verify-search-content-browser.spec.mjs",
    "verify:navigation:browser": "playwright test scripts/verify-navigation-browser.spec.mjs",
    "verify:calculator:browser": "playwright test scripts/verify-calculator-browser.spec.mjs",
    "verify:contrast:browser": "playwright test scripts/verify-control-contrast-browser.spec.mjs",
    "verify:pizza-links:browser": "playwright test scripts/verify-pizza-links-browser.spec.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-satteri": "^0.3.5",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "astro": "^7.2.0",
    "pagefind": "^1.5.2",
    "parse5": "^7.3.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3"
  }
}
